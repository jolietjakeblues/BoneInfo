        schema:addressLocality "Heveskes" ;
        schema:description "Vraagstelling: grafveld of nederzetting (gecremeerd materiaal). Na onderzoek blijkt dat het alleen om dierlijke resten gaat, waarvan schaap/geit met zekerheid is aangetoond. Er zijn geen aanwijzingen dat er op deze plek een grafveld ligt.   "@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/48> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Havezathe/ridderhofstad, HUIS HENGELO"@nl ;
        bo:complextype "Havezathe/ridderhofstad" ;
        bo:gemeente "Hengelo" ;
        bo:gewogen true ;
        bo:invoerder "Vries de, L.S." ;
        bo:omvang "11-100 bones" ;
        bo:onderzoeker "Laarman, F.J.; Amersfoort" ;
        bo:onderzoeksinstantie "Rijksdienst voor het Oudheidkundig Bodemonderzoek (ROB)" ;
        bo:opdrachtgever "Rijksdienst voor het Oudheidkundig Bodemonderzoek, Amersfoort" ;
        bo:provincie "Overijssel" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-1995" ;
        bo:vondstjaar 1995 ;
        bo:vondstverwerving "Archeologisch: opgraving" ;
        bo:zoonr 48 ;
        ceo:archis2Waarnemingsnummer "34003" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/48_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/48> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/48> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/48> ;
        schema:addressLocality "Hengelo" ;
        schema:description "Het botmateriaal is afkomstig uit een kuil in de voorhof van Huis Hengelo. De botten zijn van een volwassen varken (3-4 jaar) gezien de gebitsontwikkeling. Aanwezig zijn de schedel inclusief onderkaak en beide voorpoten compleet (van scapula tot kootjes). De conservering is zeer slecht en het lijkt of er verontreiniging op de botresten zit. Het enige meetbare bot was een mc4 met een grootste lengte van 70mm. "@nl .

