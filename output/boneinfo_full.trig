        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv31> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "1-10 bones" ;
        bo:onderzoeker "M.E.T. de Grooth, R. Lauwerier, M.E. ter Schegget" ;
        bo:onderzoeksinstantie "Rijksdienst voor het Cultureel Erfgoed" ;
        bo:opdrachtgever "Rijksdienst voor het Cultureel Erfgoed" ;
        bo:provincie "Limburg" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-2008" ;
        bo:zoonr 2174 ;
        ceo:archis2Waarnemingsnummer "435391" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2174_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2174> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2174> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2174> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Rijckholt, St. Geertruid" ;
        schema:description "Tijdens onderzoen naar de vuursteenmijnen bij Rijkckholt-St.Geertruid is een reeks nieuwe AMS-C14 dateringen uitgevoerd. Ook gedateerd is een van de meest intrigerende vondsten, de menselijke schedel 'Rijckholt 1'. Onverwacht bleek deze vondst niet Neolitisch maar van recente datum te zijn. De analyse van het monster uit de schedel 'Rijckholt 1' (GrA-26905) leverde een datering op van 210 ± 30 BP. Gekalibreerd in kalenderjaren geeft dat bij 1 sigma een datering die waarschijnlijk ligt tussen 1651-1677, 1765-1772, 1776-1800 of 1940-1951 n.Chr. En bij 2 sigma tussen 1645-1684, 1734-1806 of 1929-1951 n.Chr."@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/2175> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Crematiegraf, Saasveld"@nl ;
