    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1360> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Stad, Helmond, binnenstad"@nl ;
        bo:complextype "Stad" ;
        bo:gemeente "Helmond" ;
        bo:gewogen false ;
