        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/217> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Kesteren" ;
        schema:description "Het menselijke skelet met vondstnummer KTR90 10-1-31 lag in een greppel in de nederzetting. Op grond van twee fibulae die gevonden zijn is de datering waarschijnlijk 1e eeuw n.Chr. De morfologische kenmerken geven aan dat het om een vrouw gaat, met een lichaamslengte van ca 173 cm. De vrouw was ouder dan 50 jaar, zij had nog slechts drie tanden in de onderkaak en de randen van de wervels vertoonden woekeringen."@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/2174> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Vuursteenwinning, Savelsbos, De Kaap, Schone Grub"@nl ;
        bo:complextype "Vuursteenwinning" ;
        bo:gemeente "Eijsden-Margraten" ;
