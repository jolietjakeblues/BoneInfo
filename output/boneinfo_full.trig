        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-1990" ;
        bo:vondstjaar 1990 ;
        bo:zoonr 1000 ;
        ceo:archis2Waarnemingsnummer "33386" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1000_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1000> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1000> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1000> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Gennep" ;
        schema:description "Tijdens de opgravingscampagne van 1990 te Gennep werd een graf van een paard aangetroffen. Hoewel slechts een deel van het paard is begraven, betreft het hier een intentionele begraving. Het gaat mogelijk om een merrie. Het dier had een leeftijd tussen de 5 en 7 jaar. Ook kon de schofthoogte gereconstrueerd worden. Het botmateriaal was slecht geconserveerd. Zie ook cluster 933 en 999.  "@nl .

