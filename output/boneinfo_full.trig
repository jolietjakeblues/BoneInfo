        ceo:archis2Vondstmeldingsnummer "25192" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2077_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2077_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2077_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2077_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2077_5> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2077> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2077> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2077> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Rijswijk" ;
        schema:description """Rijswijk - De Paulinesymfonie - In 2006 vond een bureauonderzoek plaats. De resultaten waren van dien aard dat besloten werd tot de uitvoering van de volgende fase, het verkennend veldonderzoek,\r
eveneens uitgevoerd in 2006. Die fase bevestigde de archeologische\r
verwachting van het plangebied: er werden greppels gevonden uit de Romeinse tijd (eerste –\r
derde eeuw na Chr.) en de Late Middeleeuwen (14e eeuw). De vondsten duidden er op, dat in\r
het hele onderzoeksgebied archeologische resten waren te verwachten. Behoud door\r
planinpassing bleek niet haalbaar. Daarom vond in de periode november 2007 en januari 2008\r
een Definitief Onderzoek plaats.\r
\r
In totaal zijn 174 fragmenten dierlijk botmateriaal uit de Romeinse tijd onderzocht."""@nl .

