            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/275_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/275> ;
