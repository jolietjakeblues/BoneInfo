        bo:zoonr 2144 ;
        ceo:archis2Vondstmeldingsnummer "23420" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2144_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2144_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2144_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2144_4> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2144> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2144> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2144> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Geldermalsen" ;
        schema:description """Op dinsdag 17 en woensdag 18 juli 2007 heeft de Hendrik Brunsting Stichting van het Archeologisch\r
Centrum van de Vrije Universiteit (ACVU-HBS) een archeologische opgraving met beperking\r
uitgevoerd in het plangebied aan de Herman Kuijkstraat 28-32 te Geldermalsen.\r
\r
In totaal zijn er zes fragmenten bot onderzocht van deze opgraving. Het materiaal is goed geconserveerd. Drie diersoorten zijn vertegenwoordigd: rund, paard en varken.\r
Slacht-, brand- en vraatsporen zijn afwezig. Er zijn geen gegevens voor de leeftijdsbepaling. Andere\r
bijzonderheden zijn niet waargenomen.\r
\r
Onderzoeksmeldingsnr: 23420"""@nl .

