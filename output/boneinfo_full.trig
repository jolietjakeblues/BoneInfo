        bo:opdrachtgever "Dienst Stedelijke Ontwikkeling en Beheer gemeente Eindhoven" ;
        bo:provincie "Noord-Brabant" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "20-08-2006" ;
        bo:zoonr 2094 ;
        ceo:archis2Waarnemingsnummer "430537" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2094_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2094_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2094_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2094_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2094_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2094_6> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2094> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2094> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2094> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Eindhoven" ;
        schema:description """Eindhoven - Stratumseind - Van 28 augustus tot en met 11 september 2006 vond op Stratumseind 57-61 een opgraving plaats. Uit de resultaten is gebleken dat in de buurt van het Stratumseind al menselijke activiteiten\r
plaatsvonden in de 14de eeuw. Op de opgegraven locatie werden geen sporen van bewoning uit die periode gevonden, maar wel aanwijzingen dat er in de 14de-15de eeuw ambachtelijke activiteiten plaatsvonden, met\r
name het weken van wilgentenen, bijvoorbeeld voor het vlechten van manden.\r
Er kwam vermoedelijk wel bewoning in de loop van de 15de eeuw, na de eerste fase van de stadsophoging. De tweede ophogingsfase vond waarschijnlijk plaats rond 1500.\r
\r
Tijdens het archeologische onderzoek te Stratumseind zijn in totaal 342 dierlijke resten aangetroffen. Deze resten dateren uit de 14e-15e eeuw."""@nl .

