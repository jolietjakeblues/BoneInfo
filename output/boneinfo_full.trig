        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv25> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "11-100 bones" ;
        bo:onderzoeker "Spitzers, T." ;
        bo:onderzoeksinstantie "Baac bv, Den Bosch" ;
        bo:opdrachtgever "Gemeente Barneveld" ;
        bo:provincie "Gelderland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "15-02-2006" ;
        bo:zoonr 2122 ;
        ceo:archis2Waarnemingsnummer "411766" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2122_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2122_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2122> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2122> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2122> ;
        ceo:heeftVerwerving cht:5eff498d-2404-4386-8a20-de02a7de841e ;
        schema:addressLocality "Barneveld" ;
        schema:description """Barneveld Nieuwstraat - Op 15 en 16 februari 2006 is door BAAC een archeologische begeleiding uitgevoerd in de Nieuwstraat in de dorpskern van Barneveld, Gemeente Barneveld.\r
\r
Tijdens de opgraving zijn slechts enkele dierlijke botresten aangetroffen. Deze bestonden voornamelijk uit middenvoetsbeenderen van schapen of geiten en runderhoornpitten met aangrenzend deel van de achterschedel. Een concentratie of oververtegenwoordiging van deze botten is te beschouwen als afval van leerlooierij. Bij het villen liet men de horens, en bij de kleinere dieren als schapen en geiten ook de onderpoten aan de huid zitten, omdat de leerlooier daaruit informatie over de kwaliteit van de huid kon aflezen. De vondst van deze botten wijst er dan ook op dat in Barneveld huiden verwerkt zijn."""@nl .

