        bo:onderzoeker "Prummel, W., C.M. Haverkort, M. Hopman, J.M. Pasveer" ;
        bo:onderzoeksinstantie "Biologisch Archaeologisch Instituut (BAI)" ;
        bo:opdrachtgever "Biologisch Archeologisch Instituut & IPP" ;
        bo:provincie "Friesland" ;
        bo:verzamelwijze "hand collected, intensive" ;
        bo:vondstdatum "00-00-1992" ;
        bo:vondstjaar 1992 ;
        bo:zoonr 716 ;
        ceo:archis2Waarnemingsnummer "33698" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/716_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/716> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/716> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/716> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Wijnaldum" ;
        schema:description "Tijdens de opgravingscampagne in Wijnaldum van 1992 werden twee skeletten van paardenfoeten aangetroffen. De paardjes lagen op hun linkerzijde, met de poten opgetrokken. Het botmateriaal was goed geconserveerd. De ene paardenfoet was op ca 2/3 deel van de draagtijd, de andere was bijna halfweegs. De totale draagtijd van paarden is 335-346 dagen. De aanwezigheid van de paarden op de terp bewijst dat deze dieren werden gefokt.  "@nl .

