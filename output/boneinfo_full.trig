            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2109_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2109> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2109> ;
