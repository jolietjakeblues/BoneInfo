            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1745_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1745> ;
