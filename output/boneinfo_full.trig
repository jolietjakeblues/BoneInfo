            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Lookwartier"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Doetinchem" ;
        bo:gewogen true ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0222> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv25> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "101-1000 bones" ;
