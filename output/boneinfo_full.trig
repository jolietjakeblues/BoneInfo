        ceo:archis2Waarnemingsnummer "441262" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2337_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2337_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2337_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2337> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2337> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2337> ;
        ceo:heeftVerwerving cht:4e0dd439-480f-4039-bccc-4ce5ca2cbc05 ;
        schema:addressLocality "Winsum" ;
        schema:description """In 2012 heeft de Steekproef op het Boogplein te Winsum archeologisch onderzoek uitgevoerd. Daarbij werden onder meer in een mestrijke kuil de resten aangetroffen van een rund dat in anatomisch verband  begraven was. Hiervan zijn (met de hand) 86 delen verzameld. Daarnaast zijn, eveneens met de hand, 102 botresten verzameld uit diverse sporen die variëren van mestkuilen en afvalkuilen tot sloten en grachten en, in een enkel geval, wierdelagen. Het materiaal is te dateren tussen 1000-1700.\r
\r
De hier beschreven resten konden niet worden gedateerd."""@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/2344> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Well-Aijen"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Bergen" ;
        bo:gewogen true ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv31> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "1-10 bones" ;
        bo:onderzoeker "Zeiler, J.T., Leeuwarden" ;
        bo:onderzoeksinstantie "ADC Archeoprojecten & BAAC" ;
        bo:opdrachtgever "Onbekend" ;
        bo:provincie "Limburg" ;
        bo:verzamelwijze "sieved, fine: < 4mm" ;
        bo:vondstdatum "00-00-2012" ;
        bo:zoonr 2344 ;
        ceo:archis2Vondstmeldingsnummer "53146" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2344_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2344_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2344_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2344> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2344> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Well-Aijen" ;
        schema:description """In 2012 hebben het ADC en BAAC samen een opgraving uitgevoerd in de Maasvallei tussen de dorpen Aaijen en Well in de gemeente Bergen (Limburg). Daarbij is een grote afvaldump aangetroffen die voor een groot deel is uitgezeefd en een hoeveelheid (verbrand) bot bevatte. De vindplaats is redelijk uniek in de zin dat de datering mogelijk vroeg neolithicum is (eventueel Rössen); daarnaast is er een kans dat er tussen het verbrand bot ook crematies aanwezig zijn. Het Neolithische botmateriaal is gezeefd over een maaswijdte van 4 mm en is naar context in twee categorieën in te delen: materiaal uit sporen en vondstlaag en materiaal uit een depressie. Daarnaast is een enkele puntvondst verzameld. Het Mesolithische materiaal is uitgezeefd over een maaswijdte van 3 mm.\r
\r
Hier beschreven is het botmateriaal met een Mesolithische datering, het gaat in totaal om 21 resten.\r
\r
Voor dit onderzoek kon geen waarnemingsnummer worden gevonden in Archis."""@nl .

