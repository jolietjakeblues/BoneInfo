        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1953_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1953_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1953> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1953> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1953> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Ijsselstein" ;
        schema:description """Ijsselstein - Over Oudland -In de periode tussen 2 november en 21 december 2009 hebben er in het plangebied Over Oudland te Ijsselstein archeologische werkzaamheden plaatsgevonden. In totaal zijn zes werkputten aangelegd en onderzocht. In vier werkputten is dierlijk botmateriaal aangetroffen. Bij de werkputten 1, 4 en 6 kunnen de vondsten aan grafheuvels gekoppeld worden. Het botmateriaal uit werkput 3 is in kuilen aangetroffen die deel uitmaken van een (waarschijnlijk) Bronstijd structuur. Ook zijn er botresten afkomstig uit put 100; sporen die buiten de werkputten liggen en niet bij een grafheuvel behoren. \r
\r
Zes botresten zijn afkomstig uit put 100. Deze resten konden niet aan een specifieke tijdsperiode worden toegeschreven. \r
\r
Coordinaten bij benadering!"""@nl .

