        ceo:archis2Vondstmeldingsnummer "31901" ;
        ceo:archis2Waarnemingsnummer "425662" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2027_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2027> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2027> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2027> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Doetinchem" ;
        schema:description """Doetinchem - Veemarktterrein - Tijdens een archeologische opgraving op het Veemarktterrein te Doetinchem is dierlijk botmateriaal aangetroffen. Het gaat om sporen uit drie verschillende perioden: een haardkuil uit het Midden Neolithicum (S 72), vier kuilen uit de IJzertijd (S 328, 666, 1217 en 1230) en drie middeleeuwse greppels (S 1177 en 1196). Het botmateriaal is tijdens de graafwerkzaamheden met de hand verzameld. In totaal zijn in de zeven\r
sporen 23 botfragmenten aangetroffen.\r
Uiteindelijk kon slechts vier fragmenten uit de Middeleeuwen worden gedetermineerd als fragmenten van een paardenkies."""@nl .

