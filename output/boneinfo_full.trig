        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/947_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/947_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/947_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/947> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/947> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/947> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Schokland" ;
        schema:description "Op P14 is een relatief groot aantal graven uit verschillende perioden aangetroffen. Een aantal van deze graven kan in de Swifterbant periode geplaatst worden. Graf 90-177 bevat de resten van tenminste 6 en mogelijk 14 of meer individuen, waaronder een kind. In het graf zijn naast de menselijke resten 3 zeer verweerde dierlijke elementen aangetroffen. Het gaat waarschijnlijk om ornamenten/versiering van kleding.  "@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/962> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Dieregraf, RASQUERT"@nl ;
        bo:complextype "Dieregraf" ;
        bo:gemeente "Winsum" ;
