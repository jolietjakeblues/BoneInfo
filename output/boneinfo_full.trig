        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1329_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1329_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1329_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1329_4> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1329> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1329> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Arnhem" ;
        schema:description """Meer dan de helft van het materiaal betreft resten van een kalf die in een kuil zijn gevonden. Op basis van de gebitsslijtage is het dier ongeveer 5 á 6 maanden geworden. Hoewel het skelet niet helemaal compleet is kan er toch van worden uitgegaan dat het kalf als compleet kadaver in de kuil is gelegd, aangezien van elk lichaamsdeel wel enkele skeletelementen aanwezig zijn en slachtsporen niet zijn waargenomen. Op de vrij fragiele botten zijn geen vraatsporen te zien. Waarschijnlijk is het kalf meteen nadat het in de kuil is gelegd, toegedekt en niet meer bereikbaar geweest voor honden.\r
\r
Zie ook clusters 1321-1328 en 1330."""@nl .

