            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1039_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1039_7> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1039> ;
