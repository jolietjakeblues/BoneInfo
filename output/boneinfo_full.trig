            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2034_5> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2034> ;
