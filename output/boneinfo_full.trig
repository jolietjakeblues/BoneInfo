        bo:zoonr 1901 ;
        ceo:archis2Waarnemingsnummer "426059" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1901_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1901_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1901> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1901> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1901> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Den Haag" ;
        schema:description """Den Haag - Korzotheater - Het Korzotheater aan de Prinsestraat/Nobelstraat te Den Haag ligt pal ten noorden van wat vermoedelijk de oudste kern van Den Haag is. De verbouwing van het theater was derhalve reden om in juni 2009 ter plaatse een kort archeologisch onderzoek door middel van proefsleuven uit te voeren.\r
Op het terrein zijn resten van bewoningssporen zoals funderingen, vloeren, putten en kuilen aangetroffen. In een deel van deze sporen is ondermeer dierlijk botmateriaal gevonden.\r
\r
Een totaal van vijf resten is afkomstig uit de late 14e eeuw. Het betreft resten van rund en kat."""@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1907> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
