        ceo:archis2Waarnemingsnummer "50727" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_10>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_11>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1220_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1220> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1220> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1220> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Zaltbommel" ;
        schema:description """Het onderzoek had een waarderend karakter, maar indien dit snel te zien was is tevens de diersoort genoteerd. Rund is in aantal en gewicht dominant. Een groot aantal skeletelementen (N = 114, waarvan de meeste van rund) kunnen worden gebruikt voor bepaling van de slachtleeftijd.\r
Ondanks de sterke fragmentatie is het materiaal over het algemeen redelijk tot goed geconserveerd. Twee runderbotten vertonen een pathologie (exostose). Van mens zijn een schedelfragment en een fragment van tibia aangetroffen. Daarnaast bevat het materiaal twee benen artefacten: een ronde, platte knoop met vier gaatjes en een fragment van een onbekend gebruiksvoorwerp.\r
Het betreffende terrein is in gebruik geweest als kloosterterrein, stadboerderij en bleekveld."""@nl .

