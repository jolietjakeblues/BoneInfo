        ceo:archis2Waarnemingsnummer "55639" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/322_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/322_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/322> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/322> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/322> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Houten" ;
        schema:description """Onderzoek aan een menselijke inhumatie en twee skeletten van honden die begraven zijn in Houten, terrein 21, Loerik. De complete skeletten zijn onafhankelijk van de andere faunaresten bekeken (dit is gebeurd door F.J. Laarman, ROB). Het menselijke skelet was van een volwassen man die in nogal "opgevouwen vorm" was begraven. De twee honden waren allebei vrij fors (70-74 cm hoog), een van de dieren was een reu met een pathologie.\r
Zie ook clusternrs. 644, 1595, 1596, 1597 en 1598."""@nl .

