        ceo:archis2Waarnemingsnummer "417380" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_10>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_11>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_12>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_13>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1876_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1876> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1876> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1876> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Rotterdam" ;
        schema:description """Rotterdam - Laurenshof -In 2007 heeft het BOOR een opgraving uitgevoerd op de locatie Laurenshof aan de Binnenrotte te Rotterdam. De overstromingen aan het eind van de 12e eeuw maakte een eind aan de nederzetting Rotta. Nadat Rotta verdwenen was, ontstond in 1270 de middeleeuwse nederzetting Rotterdam. De bewoning breidde zich vanaf de dam in de Rotte langzaam uit en in de 14e eeuw werd ook het deel aan de Lombardstraat (de huidige Binnenrotte) bewoond. Tijdens de opgraving op het Laurenshof zijn tevens sporen uit deze laat middeleeuwse periode aangetroffen. De beerputten en mestkuilen daterend van de 14e tot en met de 17e eeuw bevatte gezamenlijk het meeste botmateriaal.\r
\r
Het totale botcomplex uit de 14e t/m de 17e eeuw bevat 510 zoogdierresten, 166 vogelresten, 47 visresten en 2 resten van een kikker of pad. \r
\r
De 147 resten uit de 15e eeuw zijn afkomstig uit een beerput/kelder en bestaan voornamelijk uit resten van kat (52). Verder bevat het spectrum enkele resten van rund, schaap/geit, varken en hond. Ook bevat de assemblage 32 resten van kip.\r
\r
Coordinaten bij benadering!"""@nl .

