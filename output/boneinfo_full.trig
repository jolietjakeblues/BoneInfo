        bo:zoonr 211 ;
        ceo:archis2Waarnemingsnummer "59349" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/211_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/211_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/211> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/211> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/211> ;
        ceo:heeftVerwerving cht:5e3bd93f-64ac-4983-b626-6e1061c2c44a ;
        schema:addressLocality "Breeveld" ;
        schema:description "Histologisch onderzoek aan drie botfragmenten uit een baggergat bij Woerden. De vraag hierbij was of het om menselijk botmateriaal kon gaan. Uit het baggergat is zeer veel Pleistocene fauna afkomstig, maar ook botmateriaal (en benen werktuigen) met een duidelijk Holocene datering. De betreffende botfragmenten hebben een datering in het Pleistoceen (C14: 38650 BP). De fragmenten bleken dierlijk te zijn (varken en mogelijk leeuw). "@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/2122> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Brug, Nieuwstraat"@nl ;
        bo:complextype "Brug" ;
        bo:gemeente "Barneveld" ;
