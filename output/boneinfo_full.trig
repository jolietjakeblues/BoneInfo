    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/2164> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Onbekend, Onbekend"@nl ;
        bo:complextype "Onbekend" ;
        bo:gemeente "Woerden" ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0632> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv30> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "T. van Kolfschoten, I. van der Jagt, Z. Beeren, V. Argiti, J. van der Leije, H. van Essen, F.S. Busschers, P. Stoel, H. van der Plicht" ;
        bo:onderzoeksinstantie "Faculty of Archaeology Leiden University, TNO - Geological Survey of The Netherlands, Center for Isotope Research Groningen University" ;
        bo:opdrachtgever "Onbekend" ;
        bo:provincie "Noord-Brabant" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-0000" ;
        bo:zoonr 2164 ;
        ceo:archis2Waarnemingsnummer "59352" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2164_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2164> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2164> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2164> ;
        ceo:heeftVerwerving cht:5e3bd93f-64ac-4983-b626-6e1061c2c44a ;
        schema:addressLocality "Woerden" ;
        schema:description """In Woerden heeft amateur archeoloog Pieter Stoel een grote hoeveelheid Pleistocene faunaresten verzameld. Deze studie richt zich op de resten van rendieren (Rangifer tarandus) uit Woerden welke goed zijn vertegenwoordigd in de fauna assemblage. Tijdens het onderzoek kon men geen verband ontdekken tussen de in Woerden aangetroffen Paleolithische artefacten en de botten van rendieren. Een gedetailleerde studie van de rendier resten wijst er op dat het gaat om één populatie met zowel jonge als oude dieren. Onder de volwassen dieren is de ratio vrouwtjes/mannetjes 2:1; dit is karakteristiek voor levende rendier populaties. Dit, samen met de standaarddeviate van de maten die zijn genomen aan de rendierbotten wijst er op dat deze resten afkomstig zijn is van één populatie en niet bestaat uit verschillende fossiele assemblages van verschillende ouderdom. De maten die zijn genomen wijzen er tevens op dat de rendieren uit Woerden slanker zijn gebouwd dan rendieren van andere vindplaatsen in noord-west en midden Europa met dezelfde ouderdom.\r
\r
LET OP: De faunaresten uit Woerden worden gedateerd tussen het vroeg Midden Pleistoceen-Laat Pleistoceen. Deze datering gaat dus nog verder terug in de tijd dan de aanduiding PALEO die hier bij begin_periode en eind_periode \r
wordt aangegeven. \r
\r
Omdat het hier gaat om botmateriaal dat is verzameld tijdens baggerwerkzaamheden is er geen Archis melding en dus ook geen waarnemingsnummer aangegeven. De coordinaten zijn opgezocht via Google maps, dus bij benadering!"""@nl .

