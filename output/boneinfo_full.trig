        bo:vondstjaar 1964 ;
        bo:zoonr 563 ;
        ceo:archis2Waarnemingsnummer "238130" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/563_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/563> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/563> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/563> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Groningen" ;
        schema:description "Bij de opgraving van vindplaats Paddepoel IV zijn 7 inhumaties aangetroffen, een crematie en een aantal losse botten of menselijke botfragmenten. Van de inhumaties konden er drie als volwassenen betiteld worden, twee als jongvolwassenen (18-20) en een kind tussen de 5-12 jaar. Daarnaast is gekeken naar de mogelijkheden voor het reconstrueren van de lichaamslengte en het bepalen van het geslacht. "@nl .

