        ceo:archis2Vondstmeldingsnummer "9892" ;
        ceo:archis2Waarnemingsnummer "424206" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1711_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1711_2>,
