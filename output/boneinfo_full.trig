        bo:vondstdatum "00-00-1995" ;
        bo:vondstjaar 1995 ;
        bo:zoonr 959 ;
        ceo:archis2Waarnemingsnummer "408914" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/959_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/959> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/959> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Vlaardingen" ;
        schema:description "Bij onderzoek aan de Joksloot, Kuiperstraat 45 te Vlaardingen zijn talloze koeienschedels gevonden. Samen met gevonden reepjes leerafval wijzen deze schedels op leerbewerkers op deze plek. Sommige van de schedels vertonen ronde gaatjes van ca een halve cm in doorsnede. Deze gaatjes zijn afkomstig van de maden van de kaasvlieg, die als ze uit het ei zijn gekomen, zich door de schedel van hun gastheer heen vreten. "@nl .

