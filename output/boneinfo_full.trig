            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2130_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2130_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2130> ;
