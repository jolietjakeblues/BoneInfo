        bo:verzamelwijze "hand collected + sieved" ;
        bo:vondstdatum "00-00-2002" ;
        bo:zoonr 1439 ;
        ceo:archis2Waarnemingsnummer "419298" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1439_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1439_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1439_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1439_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1439_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1439_6> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1439> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1439> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1439> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Venlo" ;
        schema:description """Het materiaal is afkomstig uit fase A van de Romeinse nederzetting. In deze fase is waarschijnlijk sprake van militaire activiteiten op de nederzetting. Binnen de dierlijke resten lijkt dit niet alleen tot uitdrukking te komen in een iets hoger aandeel varken ten opzichte van de andere fasen, maar vooral in de relatief goede vertegenwoordiging van voedselresten in deze fase. Mogelijk heeft de slacht van de dieren op andere plekken in de nederzetting plaatsgevonden of heeft men vleesrijke delen van elders aangevoerd.\r
De vleesvoorziening is gebaseerd op veeteelt. Wild heeft, net als gevogelte en vis, binnen de voeding nauwelijks een rol gespeeld. \r
\r
Zie ook clusters 1440 en 1441."""@nl .

