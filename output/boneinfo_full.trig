        ceo:archis2Waarnemingsnummer "50723" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1277_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1277_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1277_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1277_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1277_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1277_6> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1277> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1277> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1277> ;
        ceo:heeftVerwerving cht:a3354be9-15eb-4066-a4ec-40ed8895cb5a ;
        schema:addressLocality "Buren" ;
        schema:description "Dit is een waarderingsonderzoek waarmee wordt getracht inzicht te krijgen in de kwantiteit en kwaliteit van het botmateriaal van deze vindplaats. Het materiaal is zeer goed geconserveerd. Gegevens die meer informatie opleveren over de landbouw- en voedseleconomie, zoals slachtleeftijden, slachtsporen, schofthoogte en pathologieën, zijn bij toekomstig onderzoek te verwachten. Het botmateriaal biedt derhalve uitstekende mogelijkheden voor onderzoek naar de dierlijke component binnen de bestaanseconomie. Buren kan veel bijdragen aan de kennis over de positie van deze vindplaats in de hiërarchie van nederzettingen in het Midden-Nederlandse rivierengebied (zoals Malburg, Stenen Kamer/Linge, Dorestad en Tiel) en de rol die deze vindplaats inneemt in het toenmalige handelsnetwerk."@nl .

