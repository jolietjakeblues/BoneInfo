    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1330> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Schuytgraaf"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
