        bo:provincie "Limburg" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-0000" ;
        bo:zoonr 1343 ;
        ceo:archis2Waarnemingsnummer "410709" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1343_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1343> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1343> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Maastricht" ;
        schema:description """De resten zijn afkomstig uit een kuil (datering 950-1200 AD) en een greppel (datering 1050-1200 AD). In de kuil zijn onder meer een geweifragment van edelhert (rozenkrans) en een pijpbeenfragment van paard met kapsporen die wijzen op beenbewerking. In het materiaal uit de greppel is een bot van konijn opmerkelijk. Tot nu toe is de soort niet aangetroffen in contexten die ouder zijn dan de 13e-14e eeuw; de eerste historische vermelding dateert uit 1297. Er moet rekening mee worden gehouden dat het een intrusie betreft en het bot dus van jonger datum is.\r
Van rund is een schofthoogte vastgesteld van ca. 119 cm, wat voor deze periode vrij groot is.\r
\r
Zie ook cluster 1342."""@nl .

