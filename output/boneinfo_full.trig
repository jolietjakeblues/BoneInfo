        bo:verzamelwijze "hand collected + sieved" ;
        bo:vondstdatum "00-00-2005" ;
        bo:zoonr 1856 ;
        ceo:archis2Vondstmeldingsnummer "9574" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1856_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1856_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1856_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1856> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1856> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1856> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Eindhoven" ;
        schema:description """Eindhoven - Catharinakerk - Tijdens de opgraving van de Catharinakerk in Eindhoven in 2005 en 2006 zijn in en tussen de menselijke graven ook een klein aantal dierlijke resten aangetroffen, namelijk 433 botten en botfragmenten.\r
Het merendeel van de overige zoogdierresten is van vleesleveranciers. Rund is daarvan het best vertegenwoordigd, gevolgd door schaap en/of geit en varken. Het voedselafval is niet alleen afkomstig van zoogdieren, maar ook van (destijds) algemeen gangbaar consumptiegevogelte zoals kip en gans. Het materiaal uit de periode 1225 - 1350 bestaat uit slechts 7 resten.\r
\r
Coordinaten bij benadering!!!"""@nl .

