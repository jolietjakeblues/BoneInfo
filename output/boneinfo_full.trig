        ceo:archis2Waarnemingsnummer "429323" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2047_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2047_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2047> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2047> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2047> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Krommenie" ;
        schema:description """Krommenie - Heiligeweg - Tijdens een opgraving in 2002 aan de Heiligeweg te Krommenie zijn onder andere scherven van kookpotten, kruiken, botten, een zeildoekloodje, tinnen lepels en glaswerk gevonden. Ook is er een 'wrijfbot' aangetroffen. Het betreft een middenvoetsbeen (metatarsus) van een rund. Eén kant ervan was afgezaagd, waardoor de holle binnenzijde van het bot zichtbaar is. In het zo ontstane gat was een stukje hout geduwd. Na determinatie bleek het te gaan om hout van de fijnspar/lariks. De afgezaagde kant van het bot, inclusief het sukje hout, was glad en halfrond gesleten. Gezien de glimmende slijtageplek was het bot langdurig gebruikt. \r
\r
Coordinaten bij benadering!"""@nl .

