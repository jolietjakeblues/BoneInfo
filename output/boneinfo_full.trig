        ceo:archis2Waarnemingsnummer "32696" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/135_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/135> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/135> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/135> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Westerban" ;
        schema:description "Opgraving AWN-Den Haag. Vondst van een schedel van een hond in een stuifkuil. De vondst is van belang omdat hij een C14 datering kan opleveren voor de duinstratigrafie. De schedel is zonder onderkaak of andere beenderen gevonden. Gezien de flinke slijtage van de tanden gaat het hier om een oud tot zeer oud beest van 10 jaar of ouder. Gezien de stratigrafie is de schedel uit de 10e eeuw of ouder (mogelijk Romeins). "@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1351> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Vessem-Centrumplan"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Eersel" ;
        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0770> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv30> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "1-10 bones" ;
        bo:onderzoeker "Jong, Th. De" ;
        bo:onderzoeksinstantie "Archeologisch Centrum Vrije Universiteit, Amsterdam" ;
        bo:opdrachtgever "Gemeente Eersel" ;
        bo:provincie "Noord-Brabant" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-02-2004" ;
        bo:zoonr 1351 ;
        ceo:archis2Waarnemingsnummer "401753" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1351_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1351> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1351> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1351> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Vessem" ;
        schema:description """Bij de opgraving aan de Servatiusstraat te Vessem werd een skelet van een geit aangetroffen. Het lag in een kuil die uitgegraven was tot in het gele dekzand en die gelegen was op het erf van een boerderij. De datering is 19e - begin 20e eeuw.\r
De leeftijd van het (vrouwelijke) dier is 4,5 - 6 jaar.; de schofthoogte bedraagt ca. 66 cm. Gezien de aanwezigheid van een aantal skeletelementen van een foetus moeten de geit tijdens of kort voor de bevalling zijn gestorven.\r
Geiten werden in de 19e en 20e eeuw vooral gehouden op kleinere boerderijen en bij keuterboeren. Om die reden werd in de regio de geit ook wel "armelui's koe" genoemd."""@nl .

