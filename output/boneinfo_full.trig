        ceo:archis2Waarnemingsnummer "427386" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_10>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_11>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_12>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_13>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1752_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1752> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1752> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1752> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Hulst" ;
        schema:description """Archeozoölogisch onderzoek van het middeleeuws en post-middeleeuws botmateriaal van de opgraving de Bierkaaistraat, Hulst.\r
Er werd ongeveer 20 kilo (n=1451) goed bewaard botmateriaal bekeken. Het materiaal bestaat voor het grootste deel uit zoogdierbotten. In totaal kon 10,3% (n=150) van de resten niet op soort gedetermineerd worden (kleine fragmenten).\r
De bewoners van het terrein Bierkaaistraat aten vooral het malse vlees van jongvolwassen runderen en in mindere mate dat van schapen en varkens. Het aandeel varkensvlees op het menu nam waarschijnlijk toe in de loop van de tijd.\r
Het merendeel van het vee werd waarschijnlijk niet ter plaatse gehouden, maar kwam uit de omgeving van Hulst.\r
Dierlijke grondstoffen werden gebruikt voor het vervaardigen van allerlei voorwerpen.\r
De inhoud van de beerputten zijn vergeleken met andere middeleeuwse en vroegmoderne beerputen in Nederland en België."""@nl .

