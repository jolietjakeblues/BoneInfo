        ceo:archis2Waarnemingsnummer "429660" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2118_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2118_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2118_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2118_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2118_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2118_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2118_7> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2118> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2118> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2118> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Den Haag" ;
        schema:description """Den Haag - Hertenrade- Tussen 16 juni en 14 augustus 2006 is op het terrein Hertenrade te Den Haag een archeologische opgraving uitgevoerd. Tijdens deze werkzaamheden werd er een Romeinse nederzetting aangetroffen welke werd bewoond tussen de tweede helft van de eerste eeuw en de tweede helft van de tweede eeuw. \r
\r
Er is een beperkte hoeveelheid botmateriaal in de cultuurlaag, in greppels, kuilen en twee waterkuilen gevonden. Het materiaal is in een quickscan onderzocht. Over het algemeen is het botmateriaal behoorlijk gefragmenteerd (N=265, gewicht minder dan 4 kg).\r
Het materiaal bestaat uit 48 vondstnummers waarin voornamelijk rund (Bos taurus), paard (Equus caballus) en schaap/geit (Ovis aries/Capra hircus).\r
Hond en varken zijn beide eenmaal aangetroffen. Een vogelwervel kon niet op soort worden gedetermineerd."""@nl .

