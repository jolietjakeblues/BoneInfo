        ceo:archis2Waarnemingsnummer "34059" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1005_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1005_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1005> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1005> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1005> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Velsen" ;
        schema:description "Onderzoek aan de resten van grote huisdieren. De botten zijn afkomstig uit de Romeinse- en baggerlaag uit het gebied Westpier. Er werden slechts 3 fragmenten gevonden van paard. De overige botten waren afkomstig van rundvee. Het materiaal bestaat uit keuken- en consumptieafval. De dieren werden buiten het castellum geslacht. Zie ook clusters 127, 184, 190, 191, 454-457, 468 en 1004."@nl .

