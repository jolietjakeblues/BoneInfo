        ceo:archis2Vondstmeldingsnummer "26042" ;
        ceo:archis2Waarnemingsnummer "432533" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_10>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1660_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1660> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1660> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Zutphen" ;
        schema:description """In het kader van de nieuwbouw van het gemeentehuis van Zutphen werd in 197 archeologisch onderzoek verricht in de oude stadskern van Zutphen. Bij de opgraving werden diverse structuren aangetroffen; in totaal gaat het om twee huizen en vijf hutkommen. In totaal zijn 5134 botfragmenten onderzocht, waarvan1904 fragmenten tot op soort konden worden gedetermineerd. Het grootste deel van het determineerbaar botmateriaal is afkomstig van runderen. Het vondstenspectrum duidt op een samenstelling van met name slachtafval. Het materiaal lijkt voornamelijk het residu van primaire slacht en verwerking te zijn.\r
Tijdens deze opgraving zijn ook mensenlijke resten aangetroffen. Het gaat onder anderen om de skeletresten van twee individuen die in verschillende hutkommen werden gevonden. De context, de haksporen op de botten en de houding waarin het skelet is aangetroffen duiden op een calamiteit."""@nl .

