        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm1729> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv31> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "1-10 bones" ;
        bo:onderzoeker "Jans, J.E.A." ;
        bo:onderzoeksinstantie "RAAP Archeologisch Adviesbureau, Amsterdam" ;
        bo:opdrachtgever "Adviesbureau H. Janssen Echt B.V." ;
        bo:provincie "Limburg" ;
        bo:verzamelwijze "unknown" ;
        bo:vondstdatum "00-00-2007" ;
        bo:zoonr 2082 ;
        ceo:archis2Vondstmeldingsnummer "17979" ;
        ceo:archis2Waarnemingsnummer "427465" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2082_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2082_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2082> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2082> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2082> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Gulpen" ;
        schema:description """Gulpen - Looierstraat - In opdracht van Adviesbureau H. Janssen Echt B.V. heeft RAAP Archeologisch Advies bureau\r
in 2007 een archeologische begeleiding en opgraving uitgevoerd in plangebied Looierstraat te\r
Gulpen in de gemeente Gulpen-Wittem. Het aangetroffen vondstmateriaal wijst op eenzelfde datering van beide aangetroffen constructies in de 12e-13e eeuw, maar dit betekent natuurlijk niet noodzakelijk dat beide constructies effectief gelijktijdig hebben bestaan. \r
\r
Tijdens de begeleiding/opgraving is uit 5 sporen dierlijk botmateriaal verzameld (bijlage 2). De\r
sporen 15 en 40 betreffen kuilen van (onduidelijke) huis- of schuurplattegronden (resp. structu ren 1\r
en 2). De sporen 82 en 85 betreffen humeuze beekafzettingen in put 7 en spoor 92 is een greppel in\r
dezelfde put. In totaal zijn in deze 5 sporen 9 botfragmenten en een kies aangetroffen.\r
Op basis van het bestudeerde botmateriaal kunnen 2 diersoorten tot op de soort gedetermineerd\r
worden: rund en schaap/geit."""@nl .

