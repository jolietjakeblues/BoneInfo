        bo:provincie "Gelderland" ;
        bo:verzamelwijze "hand collected, intensive + sieved, fine" ;
        bo:vondstdatum "00-08-2004" ;
        bo:zoonr 1260 ;
        ceo:archis2Vondstmeldingsnummer "6974" ;
