        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1857_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1857_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1857_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1857_4> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1857> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1857> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1857> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Eindhoven" ;
        schema:description """Eindhoven – Catharinakerk - Tijdens de opgraving van de Catharinakerk in Eindhoven in 2005 en 2006 zijn in en tussen de menselijke graven ook een klein aantal dierlijke resten aangetroffen, namelijk 433 botten en botfragmenten.\r
Het merendeel van de overige zoogdierresten is van vleesleveranciers. Rund is daarvan het best vertegenwoordigd, gevolgd door schaap en/of geit en varken. Het voedselafval is niet alleen afkomstig van zoogdieren, maar ook van (destijds) algemeen gangbaar consumptiegevogelte zoals kip en gans. Het materiaal uit de periode 1350 - 1500 bestaat uit slechts 9 resten.\r
\r
Coordinaten bij benadering!!!"""@nl .

