        bo:invoerder "Nagels, S." ;
        bo:omvang "1-10 bones" ;
        bo:onderzoeker "Onbekend" ;
        bo:onderzoeksinstantie "Becker & Van de Graaf, Nijmegen" ;
        bo:opdrachtgever "Koppens Projecten BV" ;
        bo:provincie "Noord-Brabant" ;
        bo:verzamelwijze "unknown" ;
        bo:vondstdatum "00-05-2005" ;
        bo:zoonr 2132 ;
        ceo:archis2Waarnemingsnummer "423142" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2132_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2132_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2132> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2132> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2132> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Oss" ;
        schema:description """In opdracht van bouwbedrijf Koppens Projecten BV te Heesch werd door\r
archeologisch onderzoeksbureau Becker & Van de Graaf in april en mei 2005\r
archeologisch onderzoek uitgevoerd op het perceel van de Peperstraat 20 te Oss.\r
\r
Botfragmenten werden slechts in geringe mate en in weinig relevante context\r
aangetroffen (Bijlage 5.6.), zodat ze geen bijdrage leveren over de kennis van de\r
voedingsgewoonten van de vroegere bewoners. In de vulling van waterput 11\r
bevonden zich 31 botjes van een kip, die in de put zijn geworpen alvorens het\r
achterste gedeelte werd opgehoogd in de 2e helft van de 19e eeuw. Daarnaast\r
werd uit het ophogingspakket binnen het huis een kies en een middenhandsbeentje\r
van een rund gevonden. Tenslotte is nog een ondetermineerbaar\r
botfragment bij muur 14 gevonden.\r
\r
De elementen van kip zijn gedateerd tussen 1850 en heden. De overige resten \r
zijn niet gedateerd."""@nl .

