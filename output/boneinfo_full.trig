        bo:zoonr 1487 ;
        ceo:archis2Vondstmeldingsnummer "1485" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1487_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1487_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1487_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1487_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1487_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1487_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1487_7> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1487> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1487> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Rotterdam" ;
        schema:description """Op vier botfragmenten uit enkele 11e-12e eeuwse slootjes (object 13-27) na, zij de meeste resten afkomstig uit een 11e-12e eeuwse nederzetting (object 13-28). Daarbij is een partieel skelet van een hond, die blijkens snijsporen op de onderkaken en schedel is gevild. Er zijn geen aanwijzingen voor consumptie, wat ook geldt voor paard.\r
Behalve dit materiaal en de resten uit Romeinse contexten is ook botmateriaal in een geulvulling aangetroffen. Omdat dit verspoeld materiaal uit verschillende perioden betreft (Romeinse Tijd - Middeleeuwen), is dit niet volledig onderzocht maar gescand. Het gaat om 1492 resten, waaronder enkele artefacten.\r
\r
Zie ook clusters 1485 en 1486."""@nl .

