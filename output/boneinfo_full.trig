        bo:opdrachtgever "BAM Vastgoed" ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "04-04-2005" ;
        bo:zoonr 2089 ;
        ceo:archis2Vondstmeldingsnummer "6608" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2089_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2089_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2089> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2089> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2089> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Leidschendam-Voorburg" ;
        schema:description """Leidschendam-Voorburg - Forum Hadriani - Tussen 4 april en 28 november 2005 heeft BAAC bv in opdracht van BAM Vastgoed drie archeologische onderzoeken uitgevoerd op het voormalige Effathaterrein\r
te Voorburg. Het Effatha-terrein bevindt zich binnen de grenzen van de Romeinse stad Forum Hadriani. \r
\r
Tijdens het onderzoek zijn in totaal vijftien benen voorwerpen onderzocht. De voorwerpen dateren uit de tweede bewoningsfase (170-270 n. Chr.). Het betreft een (cosmetica?)koker, een bewerkt benen doosje of potje met deksel,een dekselknopje, haarspelden, versierde benen plaatjes, speelschijven, een bewerkt fragment van een runderrib en een oesdop. Van de benen voorwerpen is moeilijk te zeggen van welke diersoorten ze afkomstig zijn. De meeste lijken van botten van grote zoogdieren te zijn vervaardigd.\r
\r
Onderzoeksmeldingsnr:9888"""@nl .

