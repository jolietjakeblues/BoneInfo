        ceo:archis2Waarnemingsnummer "55647" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1898_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1898_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1898_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1898_4> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1898> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1898> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1898> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Rijswijk" ;
        schema:description """Rijswijk - de Schilp - Tijdens een noodopgraving bij sportcomplex de Schilp aan de Schaapweg te Rijswijk (figuur 1) zijn in het najaar van 2000 verschillende bewoningslagen uit de Nieuwe Steentijd, de IJzertijd en de Romeinse tijd gevonden. In totaal zijn er meer dan 6.100 fragmenten bot opgegraven. Uit de Romeinse laag komen 10 fragmenten, 336 fragmenten dateren mogelijk uit de Romeinse tijd, maar stammen mogelijk ook uit de Middeleeuwen of Nieuwe Tijd, een kleine 45 stammen uit de IJzertijdlaag en meer dan 5.700 fragmenten komen uit de Nieuwe Steentijd. Koolstofdatering van de oudste bewoningslaag leverde een datering op van 2.700-2.500 voor Christus, zodat deze gerekend wordt tot de zogenaamde Vlaardingen groep.\r
\r
Het materiaal uit deze cluster dateert uit de Romeinse tijd, uit de Middeleeuwen of uit de Nieuwe tijd. Het betreft in totaal 17 resten."""@nl .

