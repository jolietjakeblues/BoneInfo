        ceo:archis2Waarnemingsnummer "37984" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/105_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/105_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/105_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/105> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/105> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/105> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Alkmaar" ;
        schema:description "In 1958 werd in de bouwput van de HEMA in de Langestraat bij archeologisch onderzoek een klein aantal (26) botten verzameld. Van een enkel bot van rund kon een schofthoogte gereconstrueerd worden. Naast 17 botten van rund zijn 4 botten van varken en 5 botten van schaap/geit aangetroffen. De bouwfase in de HEMA-bouwput hoort tot een betrekkelijk korte, goed gedateerde periode in de eerste helft van de 12e eeuw.   "@nl .

