    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/2345> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Well-Aijen"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Bergen" ;
        bo:gewogen true ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv31> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Zeiler, J.T., Leeuwarden" ;
        bo:onderzoeksinstantie "ADC Archeoprojecten, BAAC" ;
        bo:opdrachtgever "Onbekend," ;
        bo:provincie "Limburg" ;
        bo:verzamelwijze "sieved, coarse: >= 4mm" ;
        bo:vondstdatum "00-00-2012" ;
        bo:zoonr 2345 ;
        ceo:archis2Vondstmeldingsnummer "53146" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2345_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2345_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2345_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2345_4> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2345> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2345> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Well-Aijen" ;
        schema:description """In 2012 hebben het ADC en BAAC samen een opgraving uitgevoerd in de Maasvallei tussen de dorpen Aaijen en Well in de gemeente Bergen (Limburg). Daarbij is een grote afvaldump aangetroffen die voor een groot deel is uitgezeefd en een hoeveelheid (verbrand) bot bevatte. De vindplaats is redelijk uniek in de zin dat de datering mogelijk vroeg neolithicum is (eventueel Rössen); daarnaast is er een kans dat er tussen het verbrand bot ook crematies aanwezig zijn. Het Neolithische botmateriaal is gezeefd over een maaswijdte van 4 mm en is naar context in twee categorieën in te delen: materiaal uit sporen en vondstlaag en materiaal uit een depressie. Daarnaast is een enkele puntvondst verzameld. Het Mesolithische materiaal is uitgezeefd over een maaswijdte van 3 mm.\r
\r
Hier beschreven is het botmateriaal met een Neolithische datering, het gaat in totaal om ruim 800 fragmenten.\r
\r
Voor dit onderzoek kon geen waarnemingsnummer worden gevonden in Archis."""@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/2358> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Grafveld, crematies, Waterdael III"@nl ;
        bo:complextype "Grafveld, crematies" ;
        bo:gemeente "Someren" ;
        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0847> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv30> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Groot, M., Amsterdam" ;
        bo:onderzoeksinstantie "ACVU-HBS" ;
        bo:opdrachtgever "onbekend" ;
        bo:provincie "Noord-Brabant" ;
        bo:verzamelwijze "unknown" ;
        bo:vondstdatum "00-00-2007" ;
        bo:zoonr 2358 ;
        ceo:archis2Vondstmeldingsnummer "22463" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2358_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2358_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2358_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2358_4> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2358> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2358> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Someren" ;
        schema:description """In 2007 is door ACVU-HBS definitief archeologisch onderzoek uitgevoerd in het plangebied Waterdael III. Tijdens het onderzoek zijn enkele grafvelden aangetroffen. Onder de belangrijkste vindplaatsen is er in de eerste plaats een klein grafveld uit de Vroege IJzertijd en het begin van de Midden IJzertijd. Twee andere prehistorische grafvelden in Waterdael III, met respectievelijk twintig en vier graven, dateren in de Midden IJzertijd. De grootste vindplaats in het plangebied stamt uit de Late IJzertijd en Romeinse tijd. Tenslotte is een tiental graven uit de Laat Romeinse tijd onderzocht.\r
\r
Het hier beschreven dierlijk botmateriaal is afkomstig uit graven uit de late ijzertijd en Romeinse tijd. Het gaat in totaal om 315 dierlijke resten.\r
\r
Voor dit onderzoek kon geen waarnemingsnummer worden gevonden in Archis. Voor het toponiem Waterdael III zijn drie onderzoeksmeldingsnummers gevonden: 19970 (IVO), 22463 en 24842 (beide definitief archeologisch onderzoek)."""@nl .

