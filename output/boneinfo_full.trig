        bo:onderzoeksinstantie "ArchaeoBone, Leeuwarden" ;
        bo:opdrachtgever "Provinciaal Archeologisch Centrum Zeeland, Middelburg" ;
        bo:provincie "Zeeland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "05-01-2000" ;
        bo:zoonr 1219 ;
        ceo:archis2Waarnemingsnummer "404253" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1219_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1219_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1219_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1219_4> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1219> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1219> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1219> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Middelburg" ;
        schema:description """Het materiaal omvat hoornpitten van tenminste 77 runderen, voornamelijk van wat oudere dieren (resp. 3-7 en 7-10 jaar). Het gaat zowel om koeien als om stieren en ossen. Uit de variaties in afmeting en vorm blijkt dat er sprake is van zowel kort gehoornd als middellang gehoornd vee.\r
Nast de hoornpitten is een klein aantal skeletresten aangetroffen van andere soorten: paard, hond en geit. In het laatste geval gaat het om een schedelfragment, wat aangeeft dat naast runderhuiden  incidenteel ook huiden van andere diersoorten zijn gelooid. Bij de botten van paard en hond is de relatie met de leerlooierij minder duidelijk."""@nl .

