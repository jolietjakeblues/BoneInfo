            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/707_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/707_7> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/707> ;
