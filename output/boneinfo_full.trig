        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv28> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Dijk, J. van" ;
        bo:onderzoeksinstantie "Archeoplan Eco, Delft" ;
        bo:opdrachtgever "ADC Archeoprojecten, Amersfoort" ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-2004" ;
        bo:zoonr 1463 ;
        ceo:archis2Waarnemingsnummer "404420" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1463_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1463_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1463_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1463_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1463_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1463_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1463_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1463_8> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1463> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1463> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1463> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Woerden" ;
        schema:description """Het materiaal is afkomstig uit de vicus. Deze is vanaf 70 na Chr. in gebruik.  Het is niet helemaal duidelijk wanneer  de vicus is verlaten. Evenals in het castellum (cluster 1462) is vooral vlees van rund gegeten, gevolgd door varken en schaap/geit, en hebben gevogelte en oesters op het menu gestaan. Aanwijzingen voor de jacht op haarwild ontbreken in de vicus. Ook vis ontbreekt, maar dat is eerder een gevolg van het ontbreken van op de zeef verzamelde resten dan dat het een voorkeur in de voeding weerspiegelt. \r
Er is een aantal voorwerpen van been en gewei aangetroffen, waaronder speelschijven en spelden.\r
\r
Zie ook clusters 694, 1286 en 1462."""@nl .

