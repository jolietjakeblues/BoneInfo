        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1851_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1851_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1851> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1851> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1851> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Arnhem" ;
        schema:description """Arnhem – Schuytgraaf - Tijdens een archeologische opgraving van vindplaats 7 in de Vinex wijk Schuytgraaf  te Arnhem, locatie zijn diverse kuilen, greppels en spiekers gevonden. De spiekers dateren mogelijk uit de IJzertijd, de greppels en de kuilen zijn inheems Romeins.\r
\r
In totaal twee elementen zijn afkomstig uit de spiekers die mogelijk dateren uit de IJzertijd. Eén element van rund en één element van een middelgroot zoogdier.\r
\r
Zie ook:\r
Zeiler, J.T., 2005a: Archeozoölogie, in: W. van de Graaf et al. (red.) Opgraving vindplaats 7-West in Arnhem-Schuytgraaf 2005, 76-78."""@nl .

