        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/87_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/87_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/87> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/87> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/87> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Stokkum" ;
        schema:description "Onderzoek aan menselijke crematies uit een urnenveld dat in 1930 door het RMO is opgegraven. Maar ook voor en na die tijd zijn er vondsten van urnen bekend uit dit urnenveld. Er zijn 11 crematies onderzocht. Het gaat om drie kinderen tussen de 0 en 6 jaar oud en 8 volwassenen. Het geslacht kon bepaald worden bij 5 mannen en 2 vrouwen. "@nl .

