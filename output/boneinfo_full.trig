    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/2317> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Het Domein"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
