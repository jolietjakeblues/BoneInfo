        bo:invoerder "Nagels, S." ;
        bo:omvang "11-100 bones" ;
        bo:onderzoeker "Kootker, L.M., Delft" ;
        bo:onderzoeksinstantie "Archeoplan Eco, Delft" ;
        bo:opdrachtgever "Ontwikkelingsbedrijf de Westlandse Zoom" ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-2009" ;
        bo:zoonr 1910 ;
        ceo:archis2Waarnemingsnummer "424591" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1910_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1910_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1910_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1910> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1910> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1910> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Poeldijk" ;
        schema:description """Poeldijk - De Kreken - In opdracht van Ontwikkelingsbedrijf de Westlandse Zoom heeft ADC ArcheoProjecten in 2009 een definitief onderzoek uitgevoerd in de Westlandse Zoom in het deelgebied De Kreken. Tijdens het definitieve onderzoek zin twee vindplaatsen gedefinieerd; vindplaats F en vindplaats G/H. Cvindplaats F bestaat uit een nederzetting uit de Ijzertijd met daarin enkele gebouwstructuren en zonder met eergetouwkrassen. Ook zijn hier sporen uit de Middeleeuwen aangetroffen. Vindplaats G/H bestaat daarentegen vooral uit verkavelingssystemen en een randzone die van een inheems-Romeinse nederzetting die beide vermoedelijk twee fases kennen; de eerste dateert uit de Late-Ijzertijd/Vroeg Romeinse tijd en de tweede fase uit de Midden Romeinse tijd.\r
\r
Uit vindplaats G/H zijn 42 dierlijke resten afkomstig uit de Middeleeuwen."""@nl .

