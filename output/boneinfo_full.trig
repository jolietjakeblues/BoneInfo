        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv27> ;
        bo:invoerder "Vries de, L.S." ;
        bo:omvang "1-10 bones" ;
        bo:onderzoeker "Greevenbroek, J.Th.R. van, AWN, Haarlem" ;
        bo:onderzoeksinstantie "Archeologische Werkgroep Haarlem" ;
        bo:opdrachtgever "Archeologische Werkgroep Haarlem" ;
        bo:provincie "Noord-Holland" ;
        bo:verzamelwijze "hand collected, intensive" ;
        bo:vondstdatum "00-00-1974" ;
