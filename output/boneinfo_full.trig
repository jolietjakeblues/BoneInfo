        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/171_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/171> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/171> ;
