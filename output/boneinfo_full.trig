        bo:zoonr 1068 ;
        ceo:archis2Waarnemingsnummer "33060" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1068_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1068_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1068> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1068> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Alphen aan den Rijn" ;
        schema:description "Tijdens de opgraving in 1985 in Alphen aan den Rijn werden een houten bouwconstructie, een goot en een afvoer gevonden. Dit geheel is geinterpreteerd als een latrine. Omdat er veel resten van insekten werden gevonden, werd belsloten deze apart te bekijken en te interpreteren. De insektenfauna weerspiegelde duidelijk de gebruiksfunctie van de latrine. De insektenfauna zei niets over de omgeving van de latrine."@nl .

