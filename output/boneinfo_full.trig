    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1654> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Kerkhof, Sint Janskerkhof/ Sint Janscathedraal"@nl ;
