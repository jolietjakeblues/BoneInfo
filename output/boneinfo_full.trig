        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0951> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv31> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "11-100 bones" ;
        bo:onderzoeker "Kootker, L.M., Delft" ;
        bo:onderzoeksinstantie "Archeoplan Eco, Delft" ;
        bo:opdrachtgever "Onbekend," ;
        bo:provincie "Limburg" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-0000" ;
        bo:zoonr 1891 ;
        ceo:archis2Waarnemingsnummer "430001" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1891_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1891_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1891_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1891> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1891> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1891> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Arensgenhout" ;
        schema:description """Arensgenhout - Diepestraat - Bij de opgraving aan de Diepestraat in Arensgenhout, gemeente Nuth (zuid Limburg) zijn drie vindplaatsen aangetroffen, respectievelijk een nederzetting uit de Volle Middeleeuwen, een villacomplex uit de Romeinse Tijd en een crematiegrafveld uit de IJzertijd.\r
In drie crematiegraven uit de Vroege tot Midden IJzertijd is tussen het menselijk materiaal in de urnen dierlijk bot aangetroffen.\r
Slechts twee botfragmenten, beide uit crematiegraf spoor 107, zijn op soort te brengen. Het gaat om een scheenbeenfragment van schaap/geit en een (tweede) teenkootfragment van rund. De overige resten zijn van middelgrote zoogdieren zoals schaap/geit of varken, of bestaan uit botsplinters. Het is wel duidelijk dat het fragmenten van zoogdieren betreft en niet van vogels of vissen.\r
\r
Coordinaten bij benadering!"""@nl .

