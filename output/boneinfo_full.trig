        bo:onderzoeker "Prummel, W.; Groningen" ;
        bo:onderzoeksinstantie "Biologisch Archaeologisch Instituut (BAI)" ;
        bo:opdrachtgever "onbekend" ;
        bo:provincie "Friesland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-0000" ;
        bo:vondstjaar 0 ;
        bo:zoonr 963 ;
        ceo:archis2Waarnemingsnummer "238122" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/963_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/963> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/963> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/963> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Hogebeintum" ;
        schema:description "Bij onderzoek aan het gemengde Merovingische/Karolingische grafveld van Hogebeintum zijn enkele inhumaties van honden aangetroffen. Het gaat om een inhumatie, waarvan alleen de schedel goed is bewaard en twee hondenschedels die mogelijk van een inhumatie afkomstig zijn. Twee van de honden zijn rond de vier jaar gestorven, de andere hond had bij overlijden een leeftijd van 9-10 jaar. Zie ook nr. 864."@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/974> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Grafveld, gemengd, MARKTVELD"@nl ;
        bo:complextype "Grafveld, gemengd" ;
        bo:gemeente "Valkenburg" ;
        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0619> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv28> ;
        bo:invoerder "Vries de, L.S." ;
        bo:omvang "unknown" ;
        bo:onderzoeker "Bult, E.J., D.P. Hallewas, M. Hoogland" ;
        bo:onderzoeksinstantie "Anatomisch Laboratorium, Rijksuniversiteit Leiden" ;
        bo:opdrachtgever "Instituut voor Pre- en Protohistorie A.E. van Giffen" ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected, intensive" ;
        bo:vondstdatum "00-00-1985" ;
        bo:vondstjaar 1985 ;
        bo:zoonr 974 ;
        ceo:archis2Waarnemingsnummer "14807" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/974_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/974> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/974> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/974> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Valkenburg" ;
        schema:description "Het grafveld bij Valkenburg-Marktveld strekt zich uit langs de weg buiten de nederzetting. Uit de leeftijd en het geslacht van de doden die op dit grafveld zijn begraven is duidelijk dat het hoofdzakelijk gaat om bewoners van het kampdorp dat bij het Romeinse fort lag. De meeste doden zijn gecremeerd, maar daarnaast zijn veel inhumaties gevonden. Deze lijkbegravingen hebben echter een slordig karakter. "@nl .

