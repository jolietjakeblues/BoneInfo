        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0396> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv27> ;
        bo:invoerder "Nagels, S." ;
