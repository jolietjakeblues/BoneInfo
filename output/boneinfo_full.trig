    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/159> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Kerk, GROTE KERK / ST. LAURENSKERK"@nl ;
        bo:complextype "Kerk" ;
        bo:gemeente "Alkmaar" ;
        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0361> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv27> ;
        bo:invoerder "Vries de, L.S." ;
        bo:omvang "more than 1000 bones" ;
        bo:onderzoeker "S. Baetsen" ;
        bo:onderzoeksinstantie "Archeologische dienst Alkmaar (bekeken bij de ROB)" ;
        bo:opdrachtgever "gemeente Alkmaar, archeologische dienst" ;
        bo:provincie "Noord-Holland" ;
        bo:verzamelwijze "hand collected, intensive" ;
        bo:vondstdatum "00-00-1994" ;
        bo:vondstjaar 1994 ;
        bo:zoonr 159 ;
        ceo:archis2Waarnemingsnummer "42878" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/159_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/159> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/159> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/159> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Alkmaar" ;
        schema:description """Onderzoek aan een steekproef van 250 skeletten, opgegraven in de Grote kerk van Alkmaar. In totaal zijn bijna 1000 skeletten opgegraven. Van de 11e tot de vroege 19e eeuw werd er in de kerk begraven. In de kerk lagen vooral de mensen met een relatief hoge sociale status. Dit onderzoek heeft uitgewezen dat osteoarthritis in de knie een relatief jong fenomeen (als gevolg van zwaarlijvigheid) is in vergelijking tot osteoarthritis in de heup.\r
Bij de opgravingen in de Grote kerk zijn twee kunstgebitten aangetroffen. Het eerste kunstgebit is afkomstig van een 48-jarige man die is begraven in 1814 in de Grote Kerk. Het gebit vervangt drie snijtanden in de onderkaak en zit vast tussen de tanden aan wwerszijden van het kunstgebit. Het tweede kunstgebit is in het graf van een ongeïdentificeerde oude vrouw in de Grote kerk gevonden. Dit kunstgebit vervangt vijf tanden in de onderkaak. Dit gebit is gemaakt van bot."""@nl .

