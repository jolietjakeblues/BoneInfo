        bo:verzamelwijze "unknown" ;
        bo:vondstdatum "06-05-2009" ;
        bo:zoonr 2134 ;
        ceo:archis2Waarnemingsnummer "434964" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2134_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2134> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2134> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2134> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Rotterdam" ;
        schema:description """Tussen 8 januari en 28 februari en tussen 23 juli en 14 november 2007 heeft het Bureau\r
Oudheidkundig Onderzoek van Gemeentewerken Rotterdam (BOOR), in opdracht van\r
het Ontwikkelingsbedrijf Rotterdam (OBR), een opgraving uitgevoerd op de locatie\r
Stadtswerf te Rotterdam.\r
\r
Vier opmerkelijk grote botten, drie ribben en een wervel, kunnen worden toegeschreven\r
aan een walvisachtige. De ribben hebben een lengte van 125 tot 140 cm, de wervel\r
heeft een omvang van 50 x 75 cm. Ze herinneren aan de deelname van Delft aan de\r
walvisvaart in de ‘Kleine Noordse Compagnie’, opgericht door twee bewindhebbers van\r
de Delftse kamer van de VOC als antwoord op de ‘Noordse Compagnie’. De kleinere\r
compagnie waaraan Delft deel nam ging in 1622 op in de Noordse Compagnie."""@nl .

