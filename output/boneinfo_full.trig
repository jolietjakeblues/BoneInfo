        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/521> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/521> ;
