    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1206> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Plangebieden Peek en Singel-West"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Bunnik" ;
        bo:gewogen true ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0312> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv26> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Zeiler, J.T., Leeuwarden" ;
        bo:onderzoeksinstantie "ArchaeoBone, Leeuwarden" ;
        bo:opdrachtgever "ADC Archeoprojecten" ;
        bo:provincie "Utrecht" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "17-04-2000" ;
        bo:zoonr 1206 ;
        ceo:archis2Waarnemingsnummer "44576" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1206_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1206_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1206_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1206_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1206_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1206_6> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1206> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1206> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1206> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Odijk" ;
        schema:description """Uit het onderzoek blijkt dat de rundveehouderij de belangrijkste pijler voor de vleesvoorziening was. Het economische belang van schaap/geit lijkt even groot te zijn geweest als dat van varken. Jacht speelde een marginale rol. Vlees van paarden en honden is naar alle waarschijnlijkheid niet gegeten. De verdeling van de slachtleeftijden van runderen wijst er op dat het zwaartepunt van de slacht in ieder geval na het tweede levensjaar lag. Dit zou betekenen dat naast productie van vlees ook beschikbaarheid van trekkracht van belang was.\r
Schofthoogtes zijn bepaald voor achtereenvolgens paard (121,1 cm), rund (109,4 en 110,6 cm) en hond (56,7 cm).\r
\r
Zie ook clusters 1207 en 1491-1498."""@nl .

