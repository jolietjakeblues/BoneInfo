        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0772> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv30> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "1-10 bones" ;
