        bo:vondstdatum "--2005" ;
        bo:zoonr 1637 ;
        ceo:archis2Vondstmeldingsnummer "16045" ;
        ceo:archis2Waarnemingsnummer "418905" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1637_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1637> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1637> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1637> ;
        ceo:heeftVerwerving cht:4e0dd439-480f-4039-bccc-4ce5ca2cbc05 ;
        schema:addressLocality "Geertruidenberg" ;
        schema:description """In totaal zijn er 254 botten aangetroffen, waarvan er 12 van vogels afkomstig waren. Rund neemt de voornaamste plaats in, gevolgd door schaap/geit, varken en paard.\r
De meeste botten zijn in de bodem terechtgekomen tijdens de bewoning tussen 1200 en 1325. Verwacht mag worden dat het dierljike botmateriaal uit deze periode heeft behoord bij één boerderij of een cluster daarvan.\r
Daarnaast zijn artefacten gevonden, zoals een fraai bewerkt mesheft van een runderbot en een glis gemaakt van een metapodium van een paard.\r
Op een humerus van een wilde eend zijn vraatsporen aangetroffen die waarschijnlijk afkomstig zijn van een fret of een bunzing."""@nl .

