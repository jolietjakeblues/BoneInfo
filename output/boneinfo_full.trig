        bo:provincie "Limburg" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-2005" ;
        bo:zoonr 1716 ;
        ceo:archis2Vondstmeldingsnummer "12335" ;
        ceo:archis2Waarnemingsnummer "423116" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1716_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1716_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1716_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1716_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1716_5> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1716> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1716> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1716> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Panningen" ;
        schema:description """Archeozoölogisch onderzoek naar dierlijk bot uit Laat-Ijzertijd crematiegraven te Panningen-Stokx.\r
Een vergelijking met andere grafvelden in Midden Limburg:\r
Wanneer wordt gekeken naar het percentage graven met dierlijk bot, ligt dat in Panningen-Stokx met biina 67% bijzonder hoog.\r
Voor wat de soortenverdeling past Panningen in het algemene patroon. Het percentage met varken (50-70%) is de belangrijkste diersoort, gevolgd door schaap/geit (20-40%).\r
Het voorkomen van paard in Panningen is bijzonder, want het is elders in Zuid-Nederland niet aangetroffen, noch in grafvelden uit de late prehistorie, noch uit de Romeinse tijd.\r
De mogelijke aanwezigheid van slechts één vogel in het grafveld is niet verwonderlijk, omdat dit pas in de Romeinse tijd belangrijker wordt in de voedingseconomie en het grafritueel."""@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1722> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Geldermalsen-Hondsgemet"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Geldermalsen" ;
        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0236> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv25> ;
        bo:invoerder "Man, Ruud de" ;
        bo:omvang "11-100 bones" ;
        bo:onderzoeker "Groot, M., Amsterdam" ;
        bo:onderzoeksinstantie "ACVU-HBS" ;
        bo:opdrachtgever "Gemeente Geldermalsen" ;
        bo:provincie "Gelderland" ;
        bo:verzamelwijze "hand collected" ;
