        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/803_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/803> ;
