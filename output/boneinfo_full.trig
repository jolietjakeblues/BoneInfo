        bo:onderzoeksinstantie "Archeologisch Centrum Vrije Universiteit, Amsterdam" ;
        bo:opdrachtgever "Gemeente Tiel" ;
        bo:provincie "Gelderland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-0000" ;
        bo:zoonr 1386 ;
        ceo:archis2Waarnemingsnummer "32881" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_10>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_11>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_12>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_13>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1386_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1386> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1386> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1386> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Tiel" ;
        schema:description """Het materiaal is afkomstig uit fase 4 van twee vlak bij elkaar gelegen sites: Passewaaijse Hogeweg (140-220 n.Chr.) en Oude Tielseweg (120-170 n.Chr.). Slachtpatronen bij rund wijzen op het belang van vlees (naast mest en trekkracht); melkproductie lijkt geen rol van betekenis te hebben gespeeld. Afname van het aandeel van schaap/geit suggereert een afname van het belang van wolproductie. Vergeleken met de voorgaande fasen neemt het aandeel van paard toe, met name in Passewaaijse Hogeweg. Een derde van de paarden op die site is niet ouder geworden dan twee jaar. Dit wijst op een specialisatie in het fokken van paarden.\r
Evenals in de voorgaande fasen wordt een deel van de deposities (partiële en complete skeletten van rund, paard, hond en edelhert) geïnterpreteerd als rituele deposities.\r
Naast materiaal uit de nederzettingen is ook dierlijk bot onderzocht uit het crematiegrafveld. De soortsamenstelling van dit materiaal wijkt duidelijk af van die uit de nederzetting.\r
\r
Zie ook clusters 1383-1385, 1387 en 1388."""@nl .

