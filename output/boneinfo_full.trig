        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/553_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/553_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/553> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/553> ;
