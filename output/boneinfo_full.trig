            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1408_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1408_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1408> ;
