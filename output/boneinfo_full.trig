        bo:verzamelwijze "hand collected, intensive" ;
        bo:vondstdatum "00-00-1995" ;
        bo:vondstjaar 1995 ;
        bo:zoonr 960 ;
        ceo:archis2Waarnemingsnummer "408914" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/960_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/960_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/960> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/960> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Vlaardingen" ;
        schema:description "Bij opgravingen aan de Joksloot, Kuiperstraat te Vlaardingen zijn enkele speelschijfjes gevonden. Twee schijfjes zijn van bot en vervaardigd uit de wervels van een haai. Beide dateren rond 1700 en zijn waarschijnlijk gebruikt als damschijven. Uit de 14e eeuwse slootvulling op de hoek van de Kuiperstraat en de Waalstraat kwam een eenvoudig fluitje tevoorschijn, gemaakt van bot."@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/963> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Dieregraf, HOGEBEINTUM"@nl ;
        bo:complextype "Dieregraf" ;
        bo:gemeente "Ferwerderadeel" ;
        bo:gewogen false ;
