        bo:zoonr 1374 ;
        ceo:archis2Waarnemingsnummer "424762" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1374_1> ;
