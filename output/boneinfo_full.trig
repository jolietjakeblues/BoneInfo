        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv28> ;
        bo:invoerder "Man, Ruud de" ;
        bo:omvang "1-10 bones" ;
        bo:onderzoeker "Zeiler, J.T., Leeuwarden" ;
        bo:onderzoeksinstantie "Gemeente Dordrecht" ;
        bo:opdrachtgever "Gemeente Dordrecht" ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected + sieved" ;
        bo:vondstdatum "00-00-2008" ;
        bo:zoonr 1815 ;
        ceo:archis2Waarnemingsnummer "438401" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1815_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1815_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1815_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1815_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1815_5> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1815> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1815> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Dordrecht" ;
        schema:description """Archeozoölogisch onderzoek van botmateriaal uit twee beerkelders van de Mijnsherenherberg in Dordrecht (1350-1500) (Beerkelder S218, 1325-1375 AD)\r
\r
Verreweg de meeste onderzochte resten zijn afkomstig uit de 15e eeuwse beerkelder (S215). Het grootste deel daarvan betreft vis; resten van zoogdieren, vogels en schelpdieren zijn veel minder talrijk. De vondst van de kwak, is slechts drie maal eerder in vergelijkbare monsters aangetroffen. Doordat er zeefmonsters genomen zijn kon er een visspectrum gedetermineerd worden.\r
\r
Uit de 14e eeuwse beerkelder kwam slecht een klein aantal resten. Hiervan is de vondst van de knobbelzwaan het vermelden waard. Daarnaast werden er voornamelijk visresten in het monster aangetroffen."""@nl .

