        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv25> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Esser, E. & J. van Dijk" ;
        bo:onderzoeksinstantie "Archeoplan Eco, Delft" ;
        bo:opdrachtgever "Baac bv, Den Bosch" ;
        bo:provincie "Gelderland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-0000" ;
        bo:zoonr 1330 ;
        ceo:archis2Vondstmeldingsnummer "12924" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1330_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1330_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1330_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1330_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1330_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1330_6> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1330> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1330> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Arnhem" ;
        schema:description """Het merendeel van de resten uit de Nieuwe tijd  behoort toe aan enkele diergraven. In een kuil hebben de skeletten van twee paarden gelegen. Het ene skelet betreft een volgroeid paard dat  minstens 3½ jaar oud is geworden. Aan de hand van enkele complete pijpbeenderen is een schofthoogte te bepalen van 131-136 cm. In dezelfde kuil lag ook het partiële skelet van een veulen, dat waarschijnlijk 4-5 maanden oud geworden. \r
In een andere kuil liggen de skeletfragmenten van een grote, volwassen hond. Hoewel het skelet niet helemaal compleet is, is de hond wel in zijn geheel begraven. Ofschoon de pijpbeenderen zijn gebroken, zijn toch enkele maten genomen om een schofthoogte te kunnen bepalen. Die heeft bij benadering tussen de 72-73 cm gelegen. Op de beenderen zijn geprononceerde spieraanhechtingen te zien, die enerzijds kenbaar maken dat de hond minimaal van middelbare leeftijd is geweest en anderzijds wijzen op een gespierd lichaam; een lichaam dat wellicht zware arbeid heeft moeten verrichten. Pathologieën die dit kunnen bevestigen zijn echter niet gevonden.\r
Het fragment van edelhert of eland betreft gewei waarvan een knoop is gemaakt.\r
\r
Zie ook clusters 1321-1329."""@nl .

