        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv25> ;
        bo:invoerder "Vries de, L." ;
        bo:omvang "11-100 bones" ;
        bo:onderzoeker "Laarman, F.J., Amersfoort" ;
        bo:onderzoeksinstantie "ROB/RACM" ;
        bo:opdrachtgever "Stichting Gelders Oudheidkundig Contact," ;
        bo:provincie "Gelderland" ;
        bo:verzamelwijze "hand collected, intensive + sieved, fine" ;
        bo:vondstdatum "27-04-2006" ;
