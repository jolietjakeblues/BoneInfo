        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1347_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1347_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1347_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1347_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1347_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1347_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1347_7> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1347> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1347> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1347> ;
        ceo:heeftVerwerving cht:a3354be9-15eb-4066-a4ec-40ed8895cb5a ;
        schema:addressLocality "Tiel" ;
        schema:description """Van de landbouwhuisdieren is rund qua gewichtsaandeel de meest belangrijke soort, hoewel van schaap/geit meer resten aanwezig zijn. Schapen en/of geiten zijn over het algemeen op vrij jonge leeftijd geslacht; runderen komen in verschillende leeftijdscategorieën voor van jong tot oud.\r
Voor paard en schaap kon een schofthoogte worden bepaald van resp. 127 cm en 57 cm.\r
Naast het gewone slacht- en consumptieafval zij twee hondenbegravingen aangetroffen. Een daarvan is zeker vroeg-Romeins, de andere is vermoedelijk uit het begin van de 1e eeuw maar dit is geenszins zeker.\r
\r
Zie ook clusters 1348, 1349, 1443, 1464 en 1465."""@nl .

