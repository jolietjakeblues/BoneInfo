            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1450_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1450_6> ;
