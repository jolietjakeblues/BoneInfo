        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1773_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1773_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1773_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1773> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1773> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1773> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Englum" ;
        schema:description """Archeozoölogisch onderzoek van botmateriaal uit coprolieten van de terp Englum, prov. Groningen (400 BC - 250 AD): een eerste indruk\r
\r
Het onderzoek is voornamelijk gericht op het onderzoek van coprolieten uit de terp te Englum. Het materiaal is afkomstig uit vershillende contexten en omvat een periode van 400 BC tot 250 AD. Het materiaal is voor een groot deel afkomstig van honden.Het aantal onderzochte botfragmenten per coproliet varieert van 3 - 15. Alle zijn afkomstig van zoogdieren, maar de meeste zijn niet nader te determineren. Er zijn geen herkenbare menselijke resten gevonden.Een deel van de middelgrote botfragmenten zou van varken afkomstig kunnen zijn.Het lijkt erop dat de honden zowwel slacht- als consumptieafval hebben gegeten."""@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1784> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Wijchen-Bijsterhuizen"@nl ;
