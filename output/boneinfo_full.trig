        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1414_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1414_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1414> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1414> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Den Bosch" ;
        schema:description "Bij enkele leerlooierskuipen is een grote hoeveelheid dierlijke resten aangetroffen, voornamelijk hoornpitten van runderen. Het merendeel is te dateren in de 18e eeuw. De hoornpitten zijn voornamelijk afkomstig van halfvolwassen (2-3 jaar) en volwassen (3-7 jaar) runderen. Het veronderstelde visuele onderscheid tussen de geslachten op grond van de vorm van de hoornpitten laat zich niet weerspiegelen in meetgegevens. Er is sprake van meerdere rundertypes."@nl .

