            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1265_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1265_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1265_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1265_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1265_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1265_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1265_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1265> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1265> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Vlaardingen" ;
        schema:description "Resten van de vleesleveranciers rund, schaap/geit en varken zijn aangetroffen. De runderen zijn ter plekke gehouden, getuige de vondst van een te vroeg geboren kalf. De runderen zijn gehouden voor vlees en melk, het leveren van trekkracht en het in stand houden van de kudde. Voor schaap/geit (en varken) zijn niet genoeg gegevens voorhanden om uitspraken over hun gebruik te doen. Paard heeft waarschijnlijk niet tot de consumptiesoorten behoord. Tot slot is de vindplaats vergeleken met twee andere inheemse vindplaatsen uit de regio, namelijk Schiedam Polderweg en Schipluiden OB 21.23."@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1324> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Schuytgraaf"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Arnhem" ;
        bo:gewogen true ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0202> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv25> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Esser, E. & J. van Dijk" ;
        bo:onderzoeksinstantie "Archeoplan Eco, Delft" ;
        bo:opdrachtgever "Baac bv, Den Bosch" ;
        bo:provincie "Gelderland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-0000" ;
        bo:zoonr 1324 ;
        ceo:archis2Vondstmeldingsnummer "12924" ;
        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_10>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1324_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1324> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1324> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Arnhem" ;
        schema:description """Het botmateriaal uit de IJzertijd-Romeinse tijd is voornamelijk gevonden in greppels, maar ook in structuren, kuilen en waterputten. Onder de resten bevindt zich een partieel skelet van een hond, afkomstig uit een greppel. Het betreft een jonge reu die 5 tot 8 maanden oud is geworden. Eveneens in een greppel is een onderkaakfragment van een kat gevonden.  Hoewel het mogelijk is dat de kat al in de IJzertijd-Romeinse tijd in de nederzetting heeft rondgelopen, kan het ook om opspit gaan. Resten van gedomesticeerde katten komen vanaf de Romeinse tijd voor maar worden doorgaans pas in latere perioden gevonden.\r
Het overgrote deel van de gedetermineerde resten is afkomstig van landbouwhuisdieren, wat aangeeft dat de nederzetting een agrarisch karakter heeft gehad gericht op zowel akkerbouw als veeteelt. Het vlees van runderen, schapen/geiten en varkens is gegeten. Runderen zijn voor alle producten gehouden. De paarden zijn gebruikt als rij- en/of lastdier.\r
\r
Zie ook clusters 1321-1323 en 1325-1330."""@nl .

