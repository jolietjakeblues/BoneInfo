        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_10>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_11>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_12>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_13>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1258_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1258> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1258> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Maastricht" ;
        schema:description """Het materiaal is afkomstig uit twee opgravingen (in 2002 en 2005) aan de Gubbelstraat te Maastricht. Het onderzoek had een waarderend karakter, maar indien dit snel te zien was is tevens de diersoort bepaald. Daarnaast is genoteerd of een bot gebruikt kan worden voor bepaling van de slachtleeftijd en/of de schofthoogte. De conservering is vrij goed.\r
Rund is in aantal en gewicht de belangrijkste soort, gevolgd door varken en schaap/geit. De rest van edelhert betreft een afgezaagde geweipunt, mogelijk een afvalstuk van geweibewerking. De datering is Karolingisch. Bijzonder is de vondst van bever, eveneens afkomstig uit een Karolingische context. De menselijke resten zijn afkomstig uit een Merovingisch graf.\r
\r
Zie ook cluster 1259."""@nl .

