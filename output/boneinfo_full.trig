        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Biddinghuizen" ;
        schema:description """Ongeveer 30.000 botjes van haring uit tonnen van het 16e eeuwse  'Biddinghuizer kolfschip' zijn onderzocht. De skeletverdeling biedt het typische beeld van gekaakte haring. Ook wordt ingegaan op mogelijke andere factoren die de skeletverdeling kunnen verklaren zoals stroming en het gewicht en de vorm van de elementen. In de publicaie wordt verder ingegaan op de mythe van de vermeende Nederlandse uitvinder van het haringkaken, Willem Beukelszoon van Biervliet.\r
\r
Onderzoeksmeldingsnummer: 198"""@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1213> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Zuiderveld-west"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Nijmegen" ;
        bo:gewogen true ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0268> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv25> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Zeiler, J.T., Leeuwarden" ;
        bo:onderzoeksinstantie "ArchaeoBone, Leeuwarden" ;
        bo:opdrachtgever "Bureau Archeologie Gemeente Nijmegen, Nijmegen" ;
        bo:provincie "Gelderland" ;
        bo:verzamelwijze "hand collected, intensive + sieved, fine" ;
        bo:vondstdatum "00-00-2000" ;
        bo:zoonr 1213 ;
        ceo:archis2Waarnemingsnummer "424398" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1213_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1213_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1213> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1213> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1213> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Ressen" ;
        schema:description """Het materiaal is afkomstig uit niveau C van put 3. Vrijwel alle resten (zowel handverzameld als gezeefd) zijn verbrand. Alleen de handverzamelde fractie leverde determineerbare resten op: een slecht geconserveerd geweifragment van edelhert en twee matig geconserveerde resten van schaap/geit (tibia en metapode). Het metapodefragment is afkomstig van een individu van meer dan 20-24 maanden oud.\r
De (gecalibreerde) C14-datering  is gebaseerd op verkoold bot (GrA -17290). Het (weinige) aardewerk in niveau C duidt echter op een veel grotere tijdsdiepte dan alleen Midden-Ijzertijd; het oudste materiaal dateert waarschijnlijk al uit de Late Bronstijd."""@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1217> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Boskade"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Jacobswoude" ;
        bo:gewogen true ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0645> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv28> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Zeiler, J.T., Leeuwarden" ;
        bo:onderzoeksinstantie "ArchaeoBone, Leeuwarden" ;
        bo:opdrachtgever "ADC Archeoprojecten, Amersfoort" ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "27-07-2002" ;
        bo:zoonr 1217 ;
        ceo:archis2Waarnemingsnummer "48178" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1217_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1217_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1217> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1217> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1217> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Hoogmade" ;
        schema:description """Het overgrote deel  van de resten komt uit een kuil in het voormalige stalgedeelte van een boerderij  (spoor 208; datering begin 18e eeuw ). Op vier kleppen van oesterschelpen na gaat het uitsluitend om resten van rund. Aanwezigheid van honden blijkt uit vraatsporen op enkele botfragmenten.\r
De verdeling van de skeletelementen en de slachtsporen op de botten geven aan dat de runderen zijn gevild en dat daarna de kadavers zijn opgedeeld in kleinere stukken voor consumptie. De resten vertegenwoordigen tenminste vier individuen. Van twee daarvan kon een schofthoogte worden bepaald van ca. 123 cm.\r
Opvallend zijn min of meer horizontaal lopende lijnen en groeven op een aantal kiezen. Nader onderzoek heeft uitgewezen dat het hier gaat om cement hyperplasie (Kierdorf et al. 2006)."""@nl .

