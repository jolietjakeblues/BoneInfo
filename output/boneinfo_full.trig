        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1903> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1903> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1903> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Den Haag" ;
        schema:description """Den Haag - Korzotheater - Het Korzotheater aan de Prinsestraat/Nobelstraat te Den Haag ligt pal ten noorden van wat vermoedelijk de oudste kern van Den Haag is. De verbouwing van het theater was derhalve reden om in juni 2009 ter plaatse een kort archeologisch onderzoek door middel van proefsleuven uit te voeren.\r
Op het terrein zijn resten van bewoningssporen zoals funderingen, vloeren, putten en kuilen aangetroffen. In een deel van deze sporen is ondermeer dierlijk botmateriaal gevonden.\r
\r
In een laat-middeleeuwse kuil is één fragment van rund aangetroffen."""@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1904> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Wijnhaeve"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Rotterdam" ;
        bo:gewogen true ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0599> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv28> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "1-10 bones" ;
        bo:onderzoeker "Kootker, L.M., M. Rijkelijkhuizen" ;
        bo:onderzoeksinstantie "Archeoplan Eco, Delft, Archeospecialisten, Amersfoort" ;
        bo:opdrachtgever "BOOR" ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-00-2006" ;
        bo:zoonr 1904 ;
        ceo:archis2Vondstmeldingsnummer "19204" ;
        ceo:archis2Waarnemingsnummer "417378" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1904_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1904> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1904> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1904> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Rotterdam" ;
        schema:description """Rotterdam - Wijnhaeve - In 2006/2007 heeft het Bureau Oudheidkundig Onderzoek van Gemeentewerken Rotterdam (BOOR) in opdracht van Ontwikkelingsbedrijf Rotterdam (OBR) en NS Vastgoed een archeologisch onderzoek verricht op de locatie ‘Wijnhaeve’ langs de Wijnhaven te Rotterdam.\r
\r
Uit een van de materiaalrijke vondstlagen zijn reststukken van leer- en hoornbewerking gevonden, zoals afsnijdsels, schedelstukken en hoornpitten van runderen. Eén van deze hoornpitten springt er qua grootte uit. Met bijna 54 centimeter is het de grootste hoornpit ooit in Nederland gerapporteerd en is zodoende als een unieke vondst te beschouwen. Door middel van isotopen onderzoek is geprobeerd om de herkomst van dit rund te achterhalen. \r
\r
Uit de resultaten van het isotopen onderzoek is gebleken dat het rund mogelijk afkomstig is uit het noorden van Duitsland, delen van Denemarken of uit westelijke delen van Italië."""@nl .

