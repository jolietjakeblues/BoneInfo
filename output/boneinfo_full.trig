            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2017_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2017> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2017> ;
