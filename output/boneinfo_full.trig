        bo:onderzoeksinstantie "ArcheoDienst BV" ;
        bo:opdrachtgever "Onbekend," ;
        bo:provincie "Limburg" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "00-02-2010" ;
        bo:zoonr 2209 ;
        ceo:archis2Vondstmeldingsnummer "39069" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2209_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2209_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2209_3> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2209> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2209> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Borgharen" ;
        schema:description """In verband met grootschalige grindafgravingen door het Consortium Grensmaas langs de Maas bij Borgharen werd tussen februari en augustus 2010 het af te graven gebied door ArcheoDienst BV archeologisch onderzocht. De opgraving bracht bewoningssporen van het Mesolithicum tot en met de Nieuwe Tijd aan het licht.\r
\r
Bij de dierlijke resten uit een geïsoleerde put, werkput 7 en de mogelijke dierbegravingen staat geen specifieke datering aangegeven. Het gaat om enkele losse resten alsmede een hondenskelet.\r
\r
Voor dit onderzoek kon geen waarneming in Archis worden gevonden.\r
Het archeozoölogische onderzoeksrapport is in DANS te vinden onder de persistent identifier: urn:nbn:nl:ui:13-evzr-01"""@nl .

