    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1483> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Kasteel, Huis ter Kleef (zuidgracht)"@nl ;
        bo:complextype "Kasteel" ;
        bo:gemeente "Haarlem" ;
        bo:gewogen true ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0392> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv27> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "more than 1000 bones" ;
        bo:onderzoeker "Esser, E., Delft" ;
        bo:onderzoeksinstantie "Archeoplan Eco, Delft" ;
        bo:opdrachtgever "Archeologische werkgroep Haarlem, Haarlem" ;
        bo:provincie "Noord-Holland" ;
        bo:verzamelwijze "sieved" ;
        bo:vondstdatum "00-00-1990" ;
        bo:zoonr 1483 ;
        ceo:archis2Waarnemingsnummer "211239" ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1483> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1483> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1483> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Haarlem" ;
        schema:description """Het betreft een analyse van de ruimtelijke verspreiding van botmateriaal in de zuidgracht. Daarbij zijn geen soorten bepaald. Er is gezeefd op maaswijdtes van 10, 4 en 2 mm.\r
De analyse laat zien dat het afval dat in dit deel van de gracht terecht is gekomen niet overal dezelfde samenstelling heeft gehad. Het materiaal is vanuit een vast punt gestort. Net als bij de andere verspreidingsanalyses van de grachtdelen van dit kasteel blijken de zwaardere zoogdierresten naast de concentratie te liggen. In de loop der tijd neemt het percentage vogel- en vooral visresten af. Dit impliceert een consumptieverandering door de tijd heen.\r
\r
Zie ook clusters 894, 895, 897-900 en 1278."""@nl .

