        ceo:archis2Waarnemingsnummer "0" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1864_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1864_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1864_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1864_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1864_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1864_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1864_7> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1864> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1864> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Holtum" ;
        schema:description """Sittard – Holtum - Door de aanleg van de N296 bij Holtum (gemeente Sittard) dreigden diverse archeologische vindplaatsen verstoord of vernietigd te worden. Op advies van de Provincie Limburg en het Rijk hebben daarom verscheidene opgravingen plaatsgevonden. Bij deze opgravingen zijn nederzettingssporen uit de Volle en Late middeleeuwen gevonden, de sporen van een Laat-Romeinse rurale nederzetting en sporen uit de IJzertijd, vermoedelijk afkomstig van een verploegd grafveld.\r
\r
De 115 resten uit de Middeleeuwen zijn bijna allemaal van gedomesticeerde zoogdieren en voornamelijk afkomstig van rund, gevolgd door varken. Paard is relatief goed vertegenwoordigd. Eén middenhandsbeen is van een grauwe of tamme gans."""@nl .

