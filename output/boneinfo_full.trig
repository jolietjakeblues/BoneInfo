        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Dalfsen" ;
        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0148> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv23> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "11-100 bones" ;
        bo:onderzoeker "Brinkhuizen, D.C., J. van Dijk" ;
        bo:onderzoeksinstantie "ArchaeoBone, Archeoplan Eco" ;
        bo:opdrachtgever "ADC Archeoprojecten, Amersfoort" ;
        bo:provincie "Overijssel" ;
        bo:verzamelwijze "hand collected + sieved" ;
        bo:vondstdatum "24-01-2005" ;
        bo:zoonr 1215 ;
        ceo:archis2Waarnemingsnummer "417390" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_10>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_11>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_12>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_8>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1215_9> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1215> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1215> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1215> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Dalfsen" ;
        schema:description """De visresten zijn afkomstig uit zeefmonsters, die ten behoeve van paleobotanisch onderzoek zijn genomen uit twee waterputten en een waterkuil (maaswijdtes 0,25 en 0,5 mm). Ook zijn niet nader gedetermineerde resten van kikker en/of pad (Anura) en van insecten aangetrofen. In enkele gevallen kon de grootte van de vissen worden bepaald. Van alle soorten is het merendeel van de resten verbrand, met uitzondering van spiering. Dit wijst mogelijk op een verschil in bereiding. Bijzonder is de aanwezigheid van kwabaal, die slechts vijf keer eerder in Nederlandse faunacomplexen is aangetroffen. Het meest aannemelijke vangstgebied van de aangetroffen soorten is de nabijgelegen Overijsselse Vecht.\r
\r
Het grootste deel van de zoogdierresten is afkomstig uit een afvalkuil. Daarnaast zijn resten gevonden in twee kuilen, een paalkuil, een waterkuil en een waterput."""@nl .

