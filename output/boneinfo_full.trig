            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1181_5> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1181> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1181> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1181> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Bodegraven" ;
        schema:description "De resten komen uit sporen uit de periode 50-250. Een deel er van kan afkomstig zijn uit de militaire vesting die op de vindplaats tussen 61 en 69 gelegen heeft. De - geringe - hoeveelheid materiaal biedt het voor de Romeinse tijd gebruikelijke beeld van slacht en maaltijdafval. De verhouding tussen de grote zoogdieren geeft eerder een inheemse dan een militaire indruk."@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1204> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Romeins villa(complex), Sandelingen Ambacht"@nl ;
        bo:complextype "Romeins villa(complex)" ;
        bo:gemeente "Hendrik Ido Ambacht" ;
        bo:gewogen true ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0531> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv28> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Zeiler, J.T., Leeuwarden" ;
        bo:onderzoeksinstantie "ArchaeoBone, Leeuwarden" ;
        bo:opdrachtgever "Synthegra Archeologie b.v." ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected" ;
        bo:vondstdatum "22-08-2005" ;
        bo:zoonr 1204 ;
        ceo:archis2Waarnemingsnummer "403243" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1204_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1204_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1204_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1204_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/1204_5> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/1204> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/1204> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/1204> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Hendrik Ido Ambacht" ;
        schema:description """Het grootste deel (75%) van het materiaal is verzameld tijdens een archeologische begeleiding, die voorafging aan de opgraving. De resten zijn over het algemeen sterk gefragmenteerd en matig geconserveerd en op twee gevallen na onverbrand. Hoewel geen skeletresten van honden zijn aangetroffen, blijkt hun aanwezigheid wel uit vraatsporen op een aantal botfragmenten. \r
De resultaten geven aan dat runderen verreweg de belangrijlste bron van dierlijk eiwit zijn geweest. De rol van het kleinvee (schapen, varkens) was in dat opzicht veel kleiner. Er zijn geen aanwijzingen dat vlees van paarden is gegeten. De leeftijdsverdeling van de runderen laat een hoog aandeel zien van oudere dieren (>3½-4 jaar), wat er mogelijk op wijst dat beschikbaarheid van trekkracht van groter belang was dan vleesproductie. Anderzijds zou het ontbreken van jonge dieren kunnen wijzen op handel, en daarmee op surplusproductie ten behoeve van de Romeinen.\r
Daarnaast zijn er aanwijzingen dat na het slachten en villen de meeste runderhuiden zijn afgevoerd. Van rund is een schofthoogte bepaald van 128,7 cm."""@nl .

