    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/1487> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, Willemsspoortunnel, object 13-27, 13-28"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Rotterdam" ;
        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0599> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv28> ;
        bo:invoerder "Zeiler, J.T." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Dijk, J. van, E. Esser" ;
        bo:onderzoeksinstantie "Archeoplan Eco, Delft" ;
        bo:opdrachtgever "Bureau Oudheidkundig Onderzoek Gemeentewerken Rotterdam, Rotterdam" ;
        bo:provincie "Zuid-Holland" ;
        bo:verzamelwijze "hand collected" ;
