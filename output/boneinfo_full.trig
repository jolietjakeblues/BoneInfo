        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/971> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/971> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/971> ;
        ceo:heeftVerwerving cht:a3354be9-15eb-4066-a4ec-40ed8895cb5a ;
        schema:addressLocality "Ellewoutsdijk" ;
        schema:description "Onderzoek aan de faunaresten van Ellewoutsdijk-Steemdammeweg /Westerscheldetunnel, vindplaats 4. Het botmateriaal is afkomstig van vee en huisdieren. Slechts enkele botten waren verbrand. Veel fragmenten vertoonden duidelijke sporen van slachtactiviteiten, zoals haksporen. Deze combinatie van slachtsporen en het ontbreken van aanwijzingen voor gekookt of gebakken voedsel duidde erop dat het slachtafval betrof.  "@nl .

    <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/cluster/995> a ceo:ArcheologischComplex,
            ceo:Vondstlocatie ;
        rdfs:label "Nederzetting, onbepaald, SCHUITEVOERDERSLAAN"@nl ;
        bo:complextype "Nederzetting, onbepaald" ;
        bo:gemeente "Medemblik" ;
        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0420> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv27> ;
        bo:invoerder "Vries de, L.S." ;
        bo:omvang "101-1000 bones" ;
        bo:onderzoeker "Seeman, M.; toenmalig bijvakstudent IPP, Amsterdam" ;
        bo:onderzoeksinstantie "Instituut voor Pre- en Protohistorie A.E. van Giffen (IPP)" ;
        bo:opdrachtgever "Instituut voor Pre- en Protohistorie A.E. van Giffen" ;
