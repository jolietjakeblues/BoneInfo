        bo:gewogen false ;
        bo:heeftGemeente <https://identifier.overheid.nl/tooi/id/gemeente/gm0056> ;
        bo:heeftProvincie <https://identifier.overheid.nl/tooi/id/provincie/pv20> ;
        bo:invoerder "Nagels, S." ;
        bo:omvang "11-100 bones" ;
        bo:onderzoeker "Jans, J.E.A." ;
        bo:onderzoeksinstantie "RAAP Archeologisch Adviesbureau, Amsterdam" ;
        bo:opdrachtgever "N.V. Nederlandse Gasunie" ;
        bo:provincie "Groningen" ;
        bo:verzamelwijze "unknown" ;
        bo:vondstdatum "06-11-2006" ;
        bo:zoonr 2081 ;
        ceo:archis2Vondstmeldingsnummer "19661" ;
        ceo:archis2Waarnemingsnummer "427696" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2081_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2081_2>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2081_3>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2081_4>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2081_5>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2081_6>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2081_7>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/2081_8> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/2081> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/2081> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/2081> ;
        ceo:heeftVerwerving cht:a3354be9-15eb-4066-a4ec-40ed8895cb5a ;
        schema:addressLocality "Grijpskerk" ;
        schema:description """Grijpskerk - Aardgastransportleiding Grijpskerk-Wieringermeer, tracédeel Grijpskerk-Workum (A-652) - In opdracht van N.V. Nederlandse Gasunie heeft RAAP Archeologisch Advies bureau van 6 t/m 15 november 2006 een inventariserend veldonderzoek in de vorm van proefsleuven uitgevoerd ten behoeve van de aanleg van een aardgastransport leiding tussen Grijpskerk en Wieringermeer. De aardgastransportleiding is opgesplitst in een tracédeel Grijpskerk-Workum (A-652) en een tracédeel Workum-Wieringermeer (A-653).\r
\r
Op basis van de resultaten van het proefsleuvenonderzoek in Grijpskerk is vast gesteld dat er\r
grondsporen en vondsten aanwezig zijn die deel uitmaken van de omgrachting en het voorterrein\r
van de voormalige Aykemaborg. De grondsporen betreffen de zuidelijke rand van de gracht om de\r
borg, 2 sloten die de toegangsweg naar de borg flankeren en een greppel. Het vondstmateriaal\r
dateert hoofdzakelijk uit de 17e en 18e eeuw.\r
\r
Het proefsleuvenonderzoek te Grijpskerk heeft in totaal 26 botten en botfragmenten alsmede 5\r
schelpfragmenten opgeleverd."""@nl .

