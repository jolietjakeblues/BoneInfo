        bo:zoonr 460 ;
        ceo:archis2Waarnemingsnummer "24999" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/460_1> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/460> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/460> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Dordrecht" ;
        schema:description """In totaal zijn skeletresten van 316 personen uit de opgraafputten nrs. 40, 42 en 45 onderzocht. De menselijke resten zijn afkomstig van de burgerij die gedurende de periode ca. 1275-1572 n. Chr. bij het Minderbroedersklooster te Dordrecht werd begraven. Het skeletmateriaal heeft alle fysisch antropologische kenmerken die passen bij een redelijk gezonde stadsbevolking. Dit blijkt o.a. uit de lengte en leeftijd. \r
Gevallen van osteoarthritis, osteophytosis en DISH worden apart beschreven."""@nl .

