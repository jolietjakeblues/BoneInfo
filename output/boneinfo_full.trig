        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/986_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/986_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/986> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/986> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/986> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Godlinze" ;
        schema:description "In 1919 verrichte Van Giffen een opgraving op de wierde Godlinze. Aangetroffen werd een vroeg middeleeuws grafveld, met zowel lijkverbranding als lijkbegraving. Gedocumenteerd werden 35 urnen, 6 andere brandgraven en 74 skeletgraven. Een van de urnen (650-850/900 AD) is onderzocht op dierlijke resten en bevatte de resten van een meeverbrand dier, een wilde eend."@nl .

