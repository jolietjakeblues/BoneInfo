            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/996_6> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/996> ;
