        ceo:archis2Waarnemingsnummer "32864" ;
        ceo:bevatObject <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/682_1>,
            <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/occurrence/682_2> ;
        ceo:heeftDatering <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/datering/682> ;
        ceo:heeftGeometrie <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/geometry/682> ;
        ceo:heeftLocatieAanduiding <https://linkeddata.cultureelerfgoed.nl/archeozoologie/id/boneinfo/locatie/682> ;
        ceo:heeftVerwerving cht:00714835-b307-4990-8f11-12b6d62bf1ba ;
        schema:addressLocality "Castricum" ;
        schema:description "Tijdens het onderzoek in Castricum-Oosterbuurt werd een grafveldje aangetroffen met 8 (min of meer complete) inhumaties en 2 verstoorde crematies. Bij de inhumaties gaat het om 3 mannen, een vrouw en 2 niet nader te bepalen individuen. Een kuil bevatte de overblijfselen van 2 baby- skeletten. Een crematiegraf bevatte de resten van een 34-40 jarig persoon. Naast de inhumatie S9 lagen de gecremeerde resten van een kind. "@nl .

